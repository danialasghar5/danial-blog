---
// Decision node — a diamond. A branch or guard. Supports one or two label lines.
interface Props { cx: number; cy: number; w?: number; h?: number; label: string; label2?: string; }
const { cx, cy, w = 120, h = 92, label, label2 } = Astro.props;
const hw = w / 2;
const hh = h / 2;
const d = `M${cx},${cy - hh} L${cx + hw},${cy} L${cx},${cy + hh} L${cx - hw},${cy} Z`;
---
<path class="dg-decision" d={d} />
{label2 ? (
	<>
		<text class="dg-label" x={cx} y={cy - 3} text-anchor="middle" font-size="14">{label}</text>
		<text class="dg-label" x={cx} y={cy + 15} text-anchor="middle" font-size="14">{label2}</text>
	</>
) : (
	<text class="dg-label" x={cx} y={cy + 5} text-anchor="middle" font-size="14">{label}</text>
)}
