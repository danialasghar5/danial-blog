---
// Failure / hazard node — a clay box. Retry, duplicate, or dead-letter.
interface Props { x: number; y: number; w: number; h?: number; label: string; sub?: string; }
const { x, y, w, h = 46, label, sub } = Astro.props;
const cx = x + w / 2;
const mid = y + h / 2;
---
<rect class="dg-hazardbox" x={x} y={y} width={w} height={h} rx="10" />
<text class="dg-label" x={cx} y={sub ? mid - 1 : mid + 5} text-anchor="middle">{label}</text>
{sub && <text class="dg-sub dg-sub--hazard" x={cx} y={mid + 15} text-anchor="middle">{sub}</text>}
