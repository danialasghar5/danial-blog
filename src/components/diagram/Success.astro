---
// Success node — the sage gate. The guarantee that holds. Optional badge pill
// and a mono code line (e.g. the guard clause).
interface Props { x: number; y: number; w: number; h?: number; label: string; badge?: string; code?: string; }
const { x, y, w, h = 52, label, badge, code } = Astro.props;
const badgeW = 66;
---
<rect class="dg-gate" x={x} y={y} width={w} height={h} rx="10" />
{badge && (
	<>
		<rect class="dg-badge" x={x + w - badgeW - 12} y={y + 10} width={badgeW} height="18" rx="9" />
		<text class="dg-badge-t" x={x + w - badgeW / 2 - 12} y={y + 22.5} text-anchor="middle">{badge}</text>
	</>
)}
<text class="dg-label" x={x + 18} y={code ? y + 22 : y + h / 2 + 5} font-size="14">{label}</text>
{code && <text class="dg-code" x={x + 18} y={y + 41}>{code}</text>}
