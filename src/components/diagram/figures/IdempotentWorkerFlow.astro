---
// Migrated from public/idempotent-sidekiq-llm-worker-retry-flow.svg — now built
// from the diagram kit (theme-aware, token-driven). The retry edge is clay
// (hazard) per the codified identity: a retry/crash is a hazard the sage gate
// absorbs.
import Diagram from '../Diagram.astro';
import Service from '../Service.astro';
import Success from '../Success.astro';
import Worker from '../Worker.astro';
import Edge from '../Edge.astro';
---
<Diagram
	viewBox="0 0 760 716"
	label="Triage worker · retry flow"
	caption="Figure 1. A retry — or a duplicate enqueue — hits the completion-state gate and returns before spending a second model call. The atomic claim (dashed) is future hardening, not yet shipped."
	ariaLabel="Idempotent Sidekiq worker flow for LLM calls in Rails. A POST persists a ticket with a UUID before enqueue; Sidekiq returns 202 Accepted; the TriageWorker checks a completion-state gate (return if ticket.completed?) before calling OpenAI, validating, and persisting the result as completed. A retry or crash before the write loops back to the gate, which makes it a no-op. A future atomic claim (pending to processing) is shown as not yet shipped."
>
	<Service x={230} y={52} w={300} label="POST /tickets" />
	<Edge d="M380 98 V122" />
	<Service x={210} y={124} w={340} h={50} label="Persist ticket · PostgreSQL" sub="UUID id (generated before enqueue)" />
	<Edge d="M380 174 V198" />
	<Service x={230} y={200} w={300} label="Sidekiq enqueue → 202 Accepted" />
	<Edge d="M380 246 V276" />

	<Worker x={120} y={276} w={520} h={372} label="TriageWorker · Sidekiq (retry: 3 → Dead Set)">
		<Success x={176} y={320} w={408} h={58} label="Completion-state gate" badge="SHIPPED" code="return if ticket.completed?  → retry is a no-op" />
		<Edge d="M380 378 V404" />
		<Service x={210} y={406} w={340} h={44} label="OpenAI call · Structured Outputs" />
		<Edge d="M380 450 V474" />
		<Service x={210} y={476} w={340} h={44} label="Validate response" />
		<Edge d="M380 520 V544" />
		<Service x={210} y={546} w={340} label="Persist result → completed" />
		<Edge variant="hazard" d="M550 569 H602 V349 H586" label="retry / crash before write" labelX={612} labelY={462} rotate={90} />
	</Worker>

	<Edge variant="future" d="M380 648 V666" />
	<rect class="dg-futurebox" x="120" y="668" width="520" height="34" rx="9" />
	<text class="dg-futuretext" x="380" y="690" text-anchor="middle">FUTURE — atomic claim: pending → processing (not shipped)</text>
</Diagram>
