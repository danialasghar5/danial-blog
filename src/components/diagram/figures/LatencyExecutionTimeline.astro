---
// Timeline figure for "Why Your Rails Background Jobs Are Slow". The SVG markup
// is the author's, verbatim; it lives in a wrapper (rendered via set:html)
// only because an inline <style>{...} block can't sit in MDX — the diagram
// itself is unchanged.
const svg = `<svg viewBox="0 0 820 210" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="t2 d2" font-family="'JetBrains Mono', ui-monospace, monospace">
  <title id="t2">Queue latency versus execution time on a job's timeline</title>
  <desc id="d2">A job's total time splits into two spans: queue latency is the wait from enqueued to picked up; execution time is from picked up to done. They are different numbers with different causes.</desc>
  <style>
    .ax{stroke:currentColor;stroke-opacity:.35;stroke-width:1.4}
    .tick{stroke:currentColor;stroke-opacity:.45;stroke-width:1.5}
    .wbar{fill:var(--dg-hazard);fill-opacity:.18;stroke:var(--dg-hazard);stroke-width:1.4}
    .rbar{fill:var(--dg-accent);fill-opacity:.18;stroke:var(--dg-accent);stroke-width:1.4}
    .ev{fill:currentColor;font-size:12.5px}
    .wl{fill:var(--dg-hazard);font-size:13px}.rl{fill:var(--dg-accent);font-size:13px}
    .sub{fill:currentColor;fill-opacity:.6;font-size:11.5px}
    text{font-family:'JetBrains Mono', ui-monospace, monospace}
  </style>

  <!-- baseline -->
  <line class="ax" x1="80" y1="150" x2="760" y2="150"/>
  <!-- ticks at enqueued(110) picked(410) done(720) -->
  <line class="tick" x1="110" y1="140" x2="110" y2="160"/>
  <line class="tick" x1="410" y1="140" x2="410" y2="160"/>
  <line class="tick" x1="720" y1="140" x2="720" y2="160"/>

  <!-- waiting span -->
  <rect class="wbar" x="110" y="96" width="300" height="34" rx="5"/>
  <text class="wl" x="260" y="118" text-anchor="middle">queue latency</text>
  <text class="sub" x="260" y="86" text-anchor="middle">the job waited</text>

  <!-- running span -->
  <rect class="rbar" x="410" y="96" width="310" height="34" rx="5"/>
  <text class="rl" x="565" y="118" text-anchor="middle">execution time</text>
  <text class="sub" x="565" y="86" text-anchor="middle">the job ran</text>

  <!-- event labels -->
  <text class="ev" x="110" y="180" text-anchor="middle">enqueued</text>
  <text class="ev" x="410" y="180" text-anchor="middle">picked up</text>
  <text class="ev" x="720" y="180" text-anchor="middle">done</text>

  <text class="sub" x="420" y="40" text-anchor="middle">total time a job appears to take = latency + execution &#8212; diagnose the bigger span first</text>
</svg>`;
---
<figure class="dg-figure">
	<div class="dg-canvas">
		<p class="dg-canvas-label">Background jobs · latency vs. execution</p>
		<Fragment set:html={svg} />
	</div>
	<figcaption class="dg-caption">The total delay a user sees is queue latency plus execution time. They have different causes and different fixes — so diagnose the larger span first.</figcaption>
</figure>

<style>
	/* Injected SVG (set:html) fills the shared diagram canvas; currentColor
	   maps to the diagram label token so text stays theme-aware. */
	.dg-canvas :global(svg) { display: block; width: 100%; height: auto; color: var(--dg-label); }
</style>
