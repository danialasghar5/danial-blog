---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import { readingTime } from '../utils/reading-time';
import { getTopic } from '../data/topics';

const { post } = Astro.props;
const { title, description, pubDate, heroImage, tags = [], category } = post.data;
const minutes = readingTime(post.body);
// Prefer the primary topic label; fall back to the first tag for uncategorized posts.
const label = getTopic(category)?.title ?? tags[0];
---
<article class="post-card-wrapper" data-tags={tags.join(',')}>
  <a class="post-card" href={`/blog/${post.id}/`}>
    {heroImage && (
      <div class="card-image">
        <Image width={720} height={405} src={heroImage} alt="" loading="lazy" />
      </div>
    )}
    <div class="card-body">
      {label && <span class="card-tag">{label}</span>}
      <h3>{title}</h3>
      <p class="desc">{description}</p>
      <div class="card-footer">
        <FormattedDate date={pubDate} />
        <span class="dot">·</span>
        <span>{minutes}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .post-card-wrapper { height: 100%; }
  .post-card {
    display: flex; flex-direction: column; height: 100%;
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    background: var(--card-bg); text-decoration: none; color: var(--text);
    overflow: hidden;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .post-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: var(--border-strong); }
  .card-image {
    width: 100%; aspect-ratio: 16 / 9; overflow: hidden;
    border-bottom: 1px solid var(--border); background: var(--bg-subtle);
  }
  .card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s cubic-bezier(.4,0,.2,1); }
  .post-card:hover .card-image img { transform: scale(1.03); }
  .card-body { padding: var(--s-3); display: flex; flex-direction: column; flex-grow: 1; gap: .5rem; }
  .card-tag {
    align-self: flex-start; font-size: var(--fs-xs); font-weight: 600;
    color: var(--text-faint); text-transform: uppercase; letter-spacing: .04em;
  }
  .post-card h3 { margin: 0; font-size: var(--fs-lg); font-weight: 700; line-height: var(--lh-snug); transition: color .15s ease; }
  .post-card:hover h3 { color: var(--brand); }
  .desc { color: var(--text-muted); font-size: var(--fs-sm); line-height: var(--lh-normal); margin: 0; flex-grow: 1; }
  .card-footer { display: flex; align-items: center; gap: .4rem; font-size: var(--fs-xs); color: var(--text-faint); margin-top: .25rem; }
  .dot { color: var(--text-faint); }
</style>
