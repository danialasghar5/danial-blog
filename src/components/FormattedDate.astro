---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			// Frontmatter dates coerce to UTC midnight; render in UTC so the visible
			// date always matches the frontmatter regardless of build-machine timezone.
			timeZone: 'UTC',
		})
	}
</time>
