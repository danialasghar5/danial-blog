---
// The brand mark: a "da" ligature. The d's tall stem is also the left edge of
// the a's bowl, so the two letters lock into one shape. d in ink (follows the
// theme), a in ruby. public/favicon.svg carries the same geometry.
// Decorative (aria-hidden); always paired with the visible "Danial Asghar"
// wordmark inside a labelled link.
interface Props {
	size?: number;
	class?: string;
}
const { size = 28, class: className } = Astro.props;
---
<svg
	class:list={['brand-mark', className]}
	width={size}
	height={size}
	viewBox="0 0 128 128"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
	focusable="false"
	style="display:block"
>
	<g fill="none" stroke-width="15" stroke-linecap="round">
		<circle cx="36" cy="80" r="21" stroke="currentColor" />
		<path d="M64 22 V101" stroke="currentColor" />
		<circle cx="85.5" cy="80" r="21" stroke="var(--brand)" />
		<path d="M114 59 V101" stroke="var(--brand)" />
	</g>
</svg>
