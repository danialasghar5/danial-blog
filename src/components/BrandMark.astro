---
// Canonical {DA} brand mark — the single source for the logo in the navbar and
// footer. Matches public/favicon.svg and the OG cards exactly (same path data,
// evergreen #2F5E4E square, white strokes). It is a fixed brand asset: it holds
// on both light and dark grounds, so it deliberately does NOT theme-shift.
// Decorative by default (aria-hidden) — it is always paired with the visible
// "Danial Asghar" wordmark inside a labeled link.
interface Props {
	size?: number;
	class?: string;
}
const { size = 30, class: className } = Astro.props;
---
<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 128 128"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
	focusable="false"
	style="display:block"
>
	<rect width="128" height="128" rx="28" fill="#2F5E4E" />
	<g fill="none" stroke="#fff" stroke-width="11" stroke-linecap="round" stroke-linejoin="round">
		<path d="M34 40 L34 88" />
		<path d="M34 40 C 62 40, 62 88, 34 88" />
		<path d="M70 88 L82 40 L94 88" />
		<path d="M74 69 L90 69" />
	</g>
</svg>
