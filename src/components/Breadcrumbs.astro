---
// Breadcrumb trail. Pass items oldest → current; the last item renders as the
// current page (no link). One quiet line: the trail itself is the way back.
// Also emits matching BreadcrumbList JSON-LD unless the page supplies its own
// (schema={false}), so the visible trail and the structured data never drift.
import { breadcrumbJsonLd, type Crumb } from '../utils/breadcrumbs';
interface Props { items: Crumb[]; schema?: boolean; }
const { items, schema = true } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((c, i) => (
      <>
        <li class:list={[{ current: i === items.length - 1 }]} aria-current={i === items.length - 1 ? 'page' : undefined}>
          {c.href && i !== items.length - 1 ? <a href={c.href}>{c.label}</a> : c.label}
        </li>
        {i < items.length - 1 && <li class="sep" aria-hidden="true">/</li>}
      </>
    ))}
  </ol>
</nav>
{schema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd(items, Astro.site, Astro.url))} is:inline />}

<style>
  .breadcrumbs { margin-bottom: var(--space-8); }
  .breadcrumbs ol {
    display: flex; flex-wrap: wrap; align-items: center; gap: .45rem;
    list-style: none; margin: 0; padding: 0;
    font-size: var(--fs-xs); color: var(--text-faint);
  }
  .breadcrumbs a { color: var(--text-muted); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--text); }
  .breadcrumbs .sep { color: var(--text-faint); }
  .breadcrumbs .current {
    color: var(--text-faint); max-width: 40ch;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
</style>
