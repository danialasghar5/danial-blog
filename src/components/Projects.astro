---
import { getCollection } from 'astro:content';

interface Props {
  showAll?: boolean;
  heading?: string;
  blurb?: string;
  withHeader?: boolean;
}
const { showAll = false, heading, blurb, withHeader = true } = Astro.props;

const all = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const displayProjects = showAll ? all : all.filter((p) => p.data.featured);
const title = heading ?? (showAll ? 'All projects' : 'Featured work');
---
<section class="projects container block">
  {withHeader && (
    <div class="section-head">
      <h2>{title}</h2>
      {!showAll && <a class="more" href="/projects">All projects &rarr;</a>}
    </div>
  )}
  {blurb && <p class="section-blurb">{blurb}</p>}
  <div class="grid-cards">
    {displayProjects.map((p) => (
      <a class="proj" href={`/projects/${p.id}/`}>
        <div class="proj-top">
          <h3>{p.data.title}</h3>
          <svg class="arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </div>
        <p class="desc">{p.data.problem}</p>
        <ul class="tech">{p.data.tech.map((t) => <li>{t}</li>)}</ul>
      </a>
    ))}
  </div>
</section>

<style>
  .block { padding-block: var(--s-6); }
  /* When a blurb follows the header row, tighten the rule→dek gap so they read
     as one header block, consistent with the section rhythm. */
  .section-head:has(+ .section-blurb) { margin-bottom: var(--s-2); }
  .section-blurb {
    margin: 0 0 var(--s-4);
    color: var(--text-muted); font-size: var(--fs-base);
    line-height: var(--lh-normal); max-width: 62ch;
  }
  .proj {
    display: flex; flex-direction: column; gap: .5rem;
    padding: var(--s-3);
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    background: var(--card-bg); color: var(--text); text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .proj:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: var(--border-strong); }
  .proj-top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
  .proj h3 { margin: 0; font-size: var(--fs-lg); font-weight: 700; }
  .proj:hover h3 { color: var(--brand); }
  .arrow { color: var(--text-faint); flex-shrink: 0; transition: transform .2s ease, color .2s ease; }
  .proj:hover .arrow { color: var(--brand); transform: translateX(2px); }
  .desc { color: var(--text-muted); font-size: var(--fs-sm); line-height: var(--lh-normal); margin: 0; }
  .tech { list-style: none; padding: 0; margin: .5rem 0 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .tech li { font-size: var(--fs-xs); padding: .2rem .55rem; border: 1px solid var(--border); border-radius: 999px; color: var(--text-muted); background: var(--bg-subtle); }
</style>
