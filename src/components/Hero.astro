---
import { NAME, ROLE, SOCIALS } from '../consts';
const {
  name = NAME,
  role = ROLE,
  tagline = "I help founders build, scale, and ship production Rails, Shopify, and AWS applications — and I write about the real engineering decisions behind them.",
} = Astro.props;

const stack = ['Ruby on Rails', 'Shopify', 'React', 'AWS', 'PostgreSQL'];
---
<section class="hero container">
  <h1>Hey, I'm <span class="highlight">{name}</span></h1>
  <p class="role">{role}</p>
  <p class="tagline">{tagline}</p>
  <div class="cta">
    <a class="btn btn-primary" href="/projects">View my work</a>
    <a class="btn btn-ghost" href="/blog">Read the blog</a>
    <a class="btn btn-ghost" href={SOCIALS.github} target="_blank" rel="noopener" aria-label="GitHub">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      GitHub
    </a>
  </div>

  <div class="stack">
    <span class="stack-label">Working with</span>
    <ul class="stack-list">{stack.map((s) => <li>{s}</li>)}</ul>
  </div>
</section>

<style>
  .hero { padding-block: var(--s-12) var(--s-8); }
  .hero h1 {
    font-size: var(--fs-4xl); line-height: var(--lh-tight);
    margin: 0; letter-spacing: var(--tracking-tighter); font-weight: 800;
    max-width: 15ch;
  }
  /* Name stays neutral — typography carries the identity, not the accent color */
  .highlight { color: var(--text); }
  .role { font-size: var(--fs-xl); font-weight: 600; color: var(--text); margin: var(--s-2) 0 var(--s-2); }
  .tagline { font-size: var(--fs-lg); line-height: var(--lh-normal); color: var(--text-muted); max-width: 60ch; margin: 0 0 var(--s-4); }
  .cta { display: flex; gap: .75rem; flex-wrap: wrap; }

  .stack {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2);
    margin-top: var(--s-8); padding-top: var(--s-4);
    border-top: 1px solid var(--border);
  }
  .stack-label {
    font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: var(--tracking-wide);
    color: var(--text-faint); font-weight: 600; white-space: nowrap;
  }
  .stack-list { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: 0; padding: 0; }
  .stack-list li {
    font-size: var(--fs-xs); font-weight: 500; color: var(--text-muted);
    padding: .3rem .7rem; border: 1px solid var(--border); border-radius: 999px; background: var(--bg-subtle);
  }
</style>
