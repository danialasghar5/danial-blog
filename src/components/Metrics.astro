---
import { metrics } from '../data/metrics';
---
{metrics.length > 0 && (
  <section class="metrics container block" aria-label="Engineering metrics">
    <ul>
      {metrics.map((m) => (
        <li>
          <span class="value">{m.value}</span>
          <span class="label">{m.label}</span>
        </li>
      ))}
    </ul>
  </section>
)}
<style>
  .block { padding-block: var(--s-6); }
  .metrics ul {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--s-3); list-style: none; margin: 0; padding: 0;
  }
  .metrics li {
    display: flex; flex-direction: column; gap: .25rem;
    padding: var(--s-4);
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    background: var(--card-bg);
  }
  .value {
    font-family: var(--font-sans);
    font-size: var(--fs-3xl); font-weight: 700;
    letter-spacing: var(--tracking-tight); line-height: 1;
  }
  .label { font-size: var(--fs-sm); color: var(--text-muted); }
</style>
