---
import FormattedDate from './FormattedDate.astro';
import { readingTime } from '../utils/reading-time';
import { getTopic } from '../data/topics';

interface Props {
	post: any;
	/** Title-only row (homepage); the full index also shows the description. */
	compact?: boolean;
}
const { post, compact = false } = Astro.props;
const { title, description, pubDate, tags = [], category } = post.data;
const minutes = readingTime(post.body);
const topic = getTopic(category);
const label = topic?.title ?? tags[0];
---
<article class:list={['post-row', { compact }]} data-category={category ?? ''} data-tags={tags.join(',')}>
	<a class="row-link" href={`/blog/${post.id}/`}>
		<span class="row-date"><FormattedDate date={pubDate} /></span>
		<div class="row-main">
			<h3 class="row-title">{title}</h3>
			{!compact && <p class="row-dek">{description}</p>}
			<p class="row-meta">
				{label && <span>{label}</span>}
				{label && <span class="row-dot" aria-hidden="true">·</span>}
				<span>{minutes}</span>
			</p>
		</div>
	</a>
</article>

<style>
	/* Index row: a faint date column on the left, the title and its meta on the
	   right, separated from the next row by a hairline. No cards, no colour until
	   hover. */
	.post-row { border-top: 1px solid var(--border); }
	.row-link {
		display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: var(--space-1) var(--space-6);
		align-items: baseline;
		padding: var(--space-6) 0;
		text-decoration: none; color: var(--text);
	}
	.compact .row-link { padding: var(--space-5) 0; }
	.row-date {
		font-size: var(--fs-sm); color: var(--text-faint);
		font-variant-numeric: tabular-nums; white-space: nowrap;
	}
	.row-main { min-width: 0; }
	.row-title {
		font-family: var(--font-sans);
		font-size: var(--fs-xl); font-weight: 600; line-height: var(--lh-snug);
		letter-spacing: var(--tracking-tight); margin: 0;
		transition: color .15s ease;
	}
	.compact .row-title { font-size: var(--fs-lg); }
	.row-link:hover .row-title { color: var(--brand); }
	.row-dek {
		font-family: var(--font-prose);
		color: var(--text-muted); font-size: var(--fs-base); line-height: var(--lh-normal);
		margin: var(--space-2) 0 0; max-width: 68ch;
	}
	.row-meta {
		display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem;
		margin: var(--space-2) 0 0;
		font-size: var(--fs-sm); color: var(--text-faint);
	}

	/* Narrow screens: the date moves above the title. */
	@media (max-width: 640px) {
		.row-link { grid-template-columns: 1fr; }
	}
</style>
