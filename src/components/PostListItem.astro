---
import FormattedDate from './FormattedDate.astro';
import Avatar from './Avatar.astro';
import { readingTime } from '../utils/reading-time';
import { getTopic, topicUrl } from '../data/topics';
import { NAME } from '../consts';

interface Props {
	post: any;
	/** Smaller title, no summary: for related-post lists. */
	compact?: boolean;
}
const { post, compact = false } = Astro.props;
const { title, description, pubDate, tags = [], category } = post.data;
const minutes = readingTime(post.body);
const topic = getTopic(category);
const href = `/blog/${post.id}/`;
---
<article class:list={['entry', { compact }]} data-category={category ?? ''} data-tags={tags.join(',')}>
	<h3 class="entry-title"><a href={href}>{title.split('::').map((part: string, i: number) => <>{i > 0 && <>::<wbr /></>}{part}</>)}</a></h3>
	{!compact && <p class="entry-dek">{description.split('::').map((part: string, i: number) => <>{i > 0 && <>::<wbr /></>}{part}</>)}</p>}
	<p class="entry-meta">
		{!compact && <Avatar size={26} />}
		{!compact && <span class="entry-author">{NAME}</span>}
		{!compact && <span class="dot" aria-hidden="true">·</span>}
		<FormattedDate date={pubDate} />
		{topic && <span class="dot" aria-hidden="true">·</span>}
		{topic && (topic.live ? <a class="entry-topic" href={topicUrl(topic.slug)}>{topic.title}</a> : <span>{topic.title}</span>)}
		<span class="dot" aria-hidden="true">·</span>
		<span>{minutes}</span>
	</p>
</article>

<style>
	/* Feed entry: big bold title, a serif summary, a byline row. Entries are
	   divided by a hairline; no cards. */
	.entry { padding: var(--space-8) 0; border-top: 1px solid var(--border); }
	.entry-title {
		font-family: var(--font-sans);
		font-size: var(--fs-2xl); font-weight: 800; line-height: 1.12;
		letter-spacing: var(--tracking-tight); margin: 0;
		text-wrap: balance; overflow-wrap: break-word; hyphens: manual;
	}
	.entry-title a { color: var(--text); text-decoration: none; }
	.entry-title a:hover { color: var(--brand); }
	.entry-dek {
		font-family: var(--font-prose);
		color: var(--text-muted); font-size: var(--fs-lg); line-height: var(--lh-normal);
		margin: var(--space-3) 0 0; max-width: 62ch;
		overflow-wrap: break-word;
	}
	.entry-meta {
		display: flex; flex-wrap: wrap; align-items: center; gap: .25rem .5rem;
		margin: var(--space-4) 0 0;
		font-size: var(--fs-sm); color: var(--text-faint);
		font-variant-numeric: tabular-nums;
	}
	.entry-author { color: var(--text-muted); font-weight: 500; }
	.entry-topic { color: var(--text-faint); text-decoration: none; }
	.entry-topic:hover { color: var(--brand); }
	.dot { color: var(--border-strong); }

	.compact { padding: var(--space-5) 0; }
	.compact .entry-title { font-size: var(--fs-lg); font-weight: 700; line-height: var(--lh-snug); }
	.compact .entry-meta { margin-top: var(--space-2); }
</style>
