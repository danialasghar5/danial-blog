---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE, SITE_DESCRIPTION, NAME, ROLE, EMAIL, SOCIALS } from '../consts';
import { Font } from 'astro:assets';
import Analytics from './Analytics.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	// When the page supplies its own article schema (e.g. TechArticle in MDX),
	// suppress the generic Article here to avoid duplicate article-type schema.
	suppressArticleSchema?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, type = 'website', suppressArticleSchema = false } = Astro.props;
// Branded OpenGraph card by default; pages may pass a specific image (e.g. post hero).
const ogImage = image ? new URL(image.src, Astro.url) : new URL('/og-default.png', Astro.site);

// Structured data: Person + WebSite on every page; Article on articles/case studies.
const site = Astro.site?.toString() ?? 'https://danialasghar.com/';
const graph: Record<string, unknown>[] = [
	{
		'@type': 'Person',
		'@id': `${site}#person`,
		name: NAME,
		jobTitle: ROLE,
		url: site,
		email: `mailto:${EMAIL}`,
		sameAs: [SOCIALS.github, SOCIALS.twitter],
	},
	{
		'@type': 'WebSite',
		'@id': `${site}#website`,
		url: site,
		name: SITE_TITLE,
		description: SITE_DESCRIPTION,
		publisher: { '@id': `${site}#person` },
	},
];
if (type === 'article' && !suppressArticleSchema) {
	graph.push({
		'@type': 'Article',
		headline: title,
		description,
		image: ogImage.toString(),
		url: Astro.url.toString(),
		mainEntityOfPage: canonicalURL.toString(),
		author: { '@id': `${site}#person` },
		publisher: { '@id': `${site}#person` },
	});
}
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- Theme Logic -->
<script is:inline>
  const t = localStorage.getItem('theme') ??
    (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  document.documentElement.dataset.theme = t;
</script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#2F5E4E" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-plex" preload />
<Font cssVariable="--font-serif" preload />
<Font cssVariable="--font-jbmono" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:image" content={ogImage} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SOCIALS.twitterHandle} />
<meta name="twitter:creator" content={SOCIALS.twitterHandle} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

<!-- Optional analytics (renders only when PUBLIC_CF_BEACON_TOKEN is set) -->
<Analytics />
