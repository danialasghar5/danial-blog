---
import { SITE_TITLE, SOCIALS, EMAIL } from '../consts';
import BrandMark from './BrandMark.astro';
const today = new Date();
const columns = [
	{ heading: 'Writing', links: [
		{ href: '/blog/', label: 'All writing' },
		{ href: '/topics/', label: 'Topics' },
		{ href: '/rss.xml', label: 'RSS' },
	] },
	{ heading: 'Work', links: [
		{ href: '/services/', label: 'Services' },
		{ href: '/tools/', label: 'Tools' },
		{ href: '/projects/', label: 'Projects' },
	] },
	{ heading: 'About', links: [
		{ href: '/about/', label: 'About' },
		{ href: '/contact/', label: 'Contact' },
		{ href: '/privacy/', label: 'Privacy' },
	] },
];
---

<footer>
	<div class="footer-container">
		<div class="footer-top">
			<div class="footer-id">
				<a href="/" class="footer-brand">
					<BrandMark size={22} />
					<span>{SITE_TITLE}</span>
				</a>
				<p class="footer-line">Reliability engineering for Rails and AI backends.</p>
			</div>
			<nav class="footer-nav" aria-label="Footer">
				{columns.map((c) => (
					<div class="footer-col">
						<p class="footer-heading">{c.heading}</p>
						<ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
					</div>
				))}
			</nav>
		</div>

		<div class="footer-bottom">
			<p class="copyright">&copy; {today.getFullYear()} {SITE_TITLE}</p>
			<div class="social-links">
				<a href={SOCIALS.github} target="_blank" rel="noopener" aria-label="GitHub">
					<span class="sr-only">GitHub</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
				</a>
				<a href={SOCIALS.twitter} target="_blank" rel="noopener" aria-label="X (Twitter)">
					<span class="sr-only">X (Twitter)</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
				</a>
				<a href={`mailto:${EMAIL}`} aria-label="Email">
					<span class="sr-only">Email</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
				</a>
			</div>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		margin-top: var(--space-24);
	}
	.footer-container {
		max-width: var(--container);
		margin-inline: auto;
		padding: var(--space-12) var(--space-6) var(--space-8);
	}
	.footer-top {
		display: grid; grid-template-columns: 1fr; gap: var(--space-10);
		padding-bottom: var(--space-10);
	}
	@media (min-width: 760px) { .footer-top { grid-template-columns: 1fr auto; } }

	.footer-brand {
		display: inline-flex; align-items: center; gap: .55rem;
		color: var(--text); font-weight: 600; font-size: var(--fs-sm); text-decoration: none;
	}
	.footer-line { margin: var(--space-3) 0 0; font-size: var(--fs-sm); color: var(--text-muted); max-width: 36ch; }

	.footer-nav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-8); }
	@media (min-width: 760px) { .footer-nav { grid-template-columns: repeat(3, 9rem); } }
	.footer-heading {
		margin: 0 0 var(--space-3);
		font-size: var(--fs-xs); font-weight: 600; color: var(--text);
	}
	.footer-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
	.footer-col a { color: var(--text-muted); font-size: var(--fs-sm); text-decoration: none; }
	.footer-col a:hover { color: var(--text); }

	.footer-bottom {
		display: flex; flex-wrap: wrap; gap: var(--space-4);
		justify-content: space-between; align-items: center;
		padding-top: var(--space-6);
		border-top: 1px solid var(--border);
	}
	.copyright { margin: 0; font-size: var(--fs-xs); color: var(--text-faint); }
	.social-links { display: flex; gap: var(--space-4); }
	.social-links a { color: var(--text-faint); display: inline-flex; align-items: center; transition: color .15s ease; }
	.social-links a:hover { color: var(--text); }
</style>
