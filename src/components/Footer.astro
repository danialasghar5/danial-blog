---
import { SITE_TITLE, SOCIALS, EMAIL } from '../consts';
const today = new Date();
const nav = [
	{ href: '/blog', label: 'Blog' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/about', label: 'About' },
	{ href: '/contact', label: 'Contact' },
	{ href: '/rss.xml', label: 'RSS' },
];
---

<footer>
	<div class="footer-container">
		<div class="footer-top">
			<a href="/" class="footer-brand">
				<span class="brand-mark" aria-hidden="true">DA</span>
				<span>{SITE_TITLE}</span>
			</a>
			<nav class="footer-nav" aria-label="Footer">
				{nav.map((l) => <a href={l.href}>{l.label}</a>)}
			</nav>
		</div>

		<div class="footer-bottom">
			<p class="copyright">&copy; {today.getFullYear()} {SITE_TITLE}</p>
			<div class="social-links">
				<a href={SOCIALS.github} target="_blank" rel="noopener" aria-label="GitHub">
					<span class="sr-only">GitHub</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
				</a>
				<a href={SOCIALS.twitter} target="_blank" rel="noopener" aria-label="X (Twitter)">
					<span class="sr-only">X (Twitter)</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
				</a>
				<a href={`mailto:${EMAIL}`} aria-label="Email">
					<span class="sr-only">Email</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
				</a>
			</div>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		background: var(--bg);
		color: var(--text-muted);
		margin-top: var(--s-12);
	}
	.footer-container {
		max-width: var(--container);
		margin-inline: auto;
		padding: var(--s-6) var(--s-3);
	}
	.footer-top {
		display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-4);
		justify-content: space-between; align-items: center;
		padding-bottom: var(--s-4);
		border-bottom: 1px solid var(--border);
	}
	.footer-brand {
		display: inline-flex; align-items: center; gap: .6rem;
		color: var(--text); font-weight: 700; text-decoration: none;
	}
	.brand-mark {
		display: inline-grid; place-items: center;
		width: 28px; height: 28px; border-radius: var(--radius-sm);
		background: var(--brand);
		color: var(--brand-contrast); font-weight: 700; font-size: .68rem;
	}
	.footer-nav { display: flex; flex-wrap: wrap; gap: var(--s-3); }
	.footer-nav a { color: var(--text-muted); font-size: var(--fs-sm); font-weight: 500; }
	.footer-nav a:hover { color: var(--text); }

	.footer-bottom {
		display: flex; flex-wrap: wrap; gap: var(--s-2);
		justify-content: space-between; align-items: center;
		padding-top: var(--s-3);
	}
	.copyright { margin: 0; font-size: var(--fs-sm); }
	.social-links { display: flex; gap: var(--s-2); }
	.social-links a {
		color: var(--text-muted); display: inline-flex; align-items: center;
		transition: color .15s ease;
	}
	.social-links a:hover { color: var(--text); }
</style>
