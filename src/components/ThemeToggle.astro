<button id="theme-toggle" aria-label="Toggle theme" class="theme-toggle">
  <span class="sun">☀</span><span class="moon">☾</span>
</button>
<style>
  .theme-toggle{background:none;border:1px solid var(--border);border-radius:8px;
    width:38px;height:38px;cursor:pointer;color:var(--text);font-size:1rem;}
  .theme-toggle:hover{background:var(--bg-subtle);}
  [data-theme="dark"] .sun{display:none;} [data-theme="light"] .moon{display:none;}
</style>
<script>
  const b = document.getElementById('theme-toggle');
  b?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
