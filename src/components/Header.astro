---
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';

const { pathname } = Astro.url;
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];
const isActive = (href) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">{SITE_TITLE}</a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {navLinks.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={['nav-link', { active: isActive(l.href) }]}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="icon-btn" href="https://github.com/danialasghar5" target="_blank" rel="noopener" aria-label="GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
      <ThemeToggle />
      <button class="menu-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>

  <nav class="nav-mobile" id="mobile-menu" aria-label="Mobile">
    <ul>
      {navLinks.map((l) => (
        <li>
          <a href={l.href} class:list={['nav-link', { active: isActive(l.href) }]}>{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    max-width: var(--container-width, 1024px);
    margin: 0 auto;
    padding: 0 1.25rem;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .brand {
    font-weight: 700; font-size: 1.05rem; letter-spacing: -0.01em;
    color: var(--text); text-decoration: none; white-space: nowrap;
  }
  .brand:hover { color: var(--brand); }

  .nav-desktop { margin-left: auto; }
  .nav-desktop ul {
    display: flex; align-items: center; gap: 0.25rem;
    list-style: none; margin: 0; padding: 0;
  }
  .nav-link {
    display: inline-flex; align-items: center;
    padding: 0.45rem 0.7rem; border-radius: 8px;
    color: var(--text-muted); font-size: 0.925rem; font-weight: 500;
    text-decoration: none; transition: color .15s ease, background .15s ease;
  }
  .nav-link:hover { color: var(--text); background: var(--bg-subtle); }
  .nav-link.active {
    color: var(--brand); font-weight: 600;
    background: color-mix(in srgb, var(--brand) 12%, transparent);
  }

  .actions { display: flex; align-items: center; gap: 0.5rem; margin-left: auto; }
  .icon-btn, .menu-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: 8px;
    border: 1px solid var(--border); background: none;
    color: var(--text-muted); cursor: pointer;
    transition: color .15s ease, background .15s ease;
  }
  .icon-btn:hover, .menu-btn:hover { color: var(--text); background: var(--bg-subtle); }
  .menu-btn { display: none; }

  .nav-mobile { display: none; border-top: 1px solid var(--border); }
  .nav-mobile ul {
    list-style: none; margin: 0;
    padding: 0.5rem 1.25rem 1rem;
    display: flex; flex-direction: column; gap: 0.25rem;
  }
  .nav-mobile .nav-link { padding: 0.7rem 0.75rem; font-size: 1rem; }

  @media (max-width: 720px) {
    .nav-desktop { display: none; }
    .menu-btn { display: inline-flex; }
    .site-header.is-open .nav-mobile { display: block; }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const btn = document.getElementById('menu-btn');
  btn?.addEventListener('click', () => {
    const open = header.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  document.querySelectorAll('.nav-mobile a').forEach((a) =>
    a.addEventListener('click', () => header?.classList.remove('is-open'))
  );
</script>
