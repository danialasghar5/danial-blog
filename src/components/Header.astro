---
import ThemeToggle from './ThemeToggle.astro';
import BrandMark from './BrandMark.astro';
import { SITE_TITLE, SOCIALS } from '../consts';

const { pathname } = Astro.url;
// Topics is folded into the Writing index, so "Writing" also lights up on the
// /topics/* hub pages. Services is not in this list: it is the header's single
// primary action (the button on the right).
const navLinks = [
  { href: '/blog', label: 'Writing', match: ['/blog', '/topics'] },
  { href: '/projects', label: 'Projects' },
  { href: '/tools', label: 'Tools' },
  { href: '/about', label: 'About' },
];
const matches = (paths: string[]) =>
  paths.some((p) => pathname === p || pathname.startsWith(p + '/'));
const isActive = (link: { href: string; match?: string[] }) => matches(link.match ?? [link.href]);
const onServices = matches(['/services']);
---
<a href="#main-content" class="skip-link">Skip to content</a>
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label={`${SITE_TITLE} — home`}>
      <BrandMark size={24} />
      <span class="brand-name">{SITE_TITLE}</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {navLinks.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={['nav-link', { active: isActive(l) }]}
              aria-current={isActive(l) ? 'page' : undefined}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="icon-btn" href={SOCIALS.github} target="_blank" rel="noopener" aria-label="GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
      <ThemeToggle />
      <a class="btn btn-primary btn-sm header-cta" href="/services" aria-current={onServices ? 'page' : undefined}>Services</a>
      <button class="menu-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="i-open" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="8" x2="20" y2="8"/><line x1="4" y1="16" x2="20" y2="16"/></svg>
        <svg class="i-close" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile: full-screen sheet under the header bar. -->
  <nav class="nav-mobile" id="mobile-menu" aria-label="Mobile">
    <ul>
      {navLinks.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={['m-link', { active: isActive(l) }]}
            aria-current={isActive(l) ? 'page' : undefined}
          >{l.label}</a>
        </li>
      ))}
    </ul>
    <a class="btn btn-primary m-cta" href="/services" aria-current={onServices ? 'page' : undefined}>Services <span aria-hidden="true">&rarr;</span></a>
  </nav>
</header>

<style>
  .skip-link {
    position: absolute; left: 8px; top: -60px; z-index: 100;
    padding: .5rem .9rem; border-radius: var(--radius-sm);
    background: var(--brand); color: var(--brand-contrast);
    font-size: var(--fs-sm); font-weight: 600; text-decoration: none;
    transition: top .15s ease;
  }
  .skip-link:focus { top: 8px; }

  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--space-6);
    height: var(--header-h);
    display: flex; align-items: center; gap: var(--space-6);
  }

  /* Brand */
  .brand {
    display: inline-flex; align-items: center; gap: .55rem;
    color: var(--text); text-decoration: none; white-space: nowrap;
    margin-right: auto;
  }
  .brand-name { font-weight: 600; font-size: var(--fs-sm); letter-spacing: -0.005em; }
  .brand:hover .brand-name { color: var(--text); }

  /* Desktop nav: plain text links; the current page gets accent text and a
     1px accent underline sitting on the header's bottom hairline. */
  .nav-desktop ul { display: flex; align-items: center; gap: var(--space-6); list-style: none; margin: 0; padding: 0; }
  .nav-link {
    position: relative; display: inline-flex; align-items: center;
    height: var(--header-h);
    color: var(--text-muted); font-size: var(--fs-sm); font-weight: 500;
    text-decoration: none; transition: color .15s ease;
  }
  .nav-link:hover { color: var(--text); }
  .nav-link.active { color: var(--brand); }
  .nav-link.active::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -1px;
    height: 1px; background: var(--brand);
  }

  /* Actions */
  .actions { display: flex; align-items: center; gap: var(--space-1); }
  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: var(--radius-sm);
    color: var(--text-muted);
    transition: color .15s ease, background .15s ease;
  }
  .icon-btn:hover { color: var(--text); background: var(--bg-subtle); }
  .header-cta { margin-left: var(--space-2); }

  .menu-btn {
    display: none; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: var(--radius-sm);
    border: 0; background: none; color: var(--text); cursor: pointer;
  }
  .menu-btn:hover { background: var(--bg-subtle); }
  .menu-btn .i-close { display: none; }

  /* Mobile sheet */
  .nav-mobile {
    display: none;
    position: fixed; inset: var(--header-h) 0 0 0; z-index: 49;
    background: var(--bg);
    padding: var(--space-4) var(--space-6) var(--space-10);
    overflow-y: auto;
    flex-direction: column; gap: var(--space-8);
  }
  .nav-mobile ul { list-style: none; margin: 0; padding: 0; }
  .nav-mobile li { border-bottom: 1px solid var(--border); }
  .m-link {
    display: block; padding: var(--space-4) 0;
    font-size: var(--fs-xl); font-weight: 600; letter-spacing: var(--tracking-tight);
    color: var(--text); text-decoration: none;
  }
  .m-link.active { color: var(--brand); }
  .m-cta { justify-content: center; padding-block: .9rem; font-size: var(--fs-base); }

  @media (max-width: 780px) {
    .nav-desktop, .header-cta { display: none; }
    .menu-btn { display: inline-flex; }
    .site-header.is-open .nav-mobile { display: flex; }
    .site-header.is-open .menu-btn .i-open { display: none; }
    .site-header.is-open .menu-btn .i-close { display: inline; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const btn = document.getElementById('menu-btn');
  const setOpen = (open: boolean) => {
    header?.classList.toggle('is-open', open);
    // Lock page scroll behind the full-screen sheet.
    document.documentElement.style.overflow = open ? 'hidden' : '';
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  btn?.addEventListener('click', () => setOpen(!header?.classList.contains('is-open')));
  document.querySelectorAll('.nav-mobile a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('is-open')) { setOpen(false); btn?.focus(); }
  });
  // Leaving the mobile breakpoint with the sheet open must not leave the page locked.
  matchMedia('(min-width: 781px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
</script>
