---
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE, SOCIALS } from '../consts';

const { pathname } = Astro.url;
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];
const isActive = (href) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---
<a href="#main-content" class="skip-link">Skip to content</a>
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label={`${SITE_TITLE} — home`}>
      <span class="brand-mark" aria-hidden="true">DA</span>
      <span class="brand-name">{SITE_TITLE}</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {navLinks.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={['nav-link', { active: isActive(l.href) }]}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="icon-btn" href={SOCIALS.github} target="_blank" rel="noopener" aria-label="GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
      <ThemeToggle />
      <a class="btn btn-primary btn-sm cta-desktop" href="/contact">Get in touch</a>
      <button class="menu-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="i-open" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg class="i-close" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
      </button>
    </div>
  </div>

  <nav class="nav-mobile" id="mobile-menu" aria-label="Mobile">
    <ul>
      {navLinks.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={['nav-link', { active: isActive(l.href) }]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >{l.label}</a>
        </li>
      ))}
      <li><a href="/contact" class="btn btn-primary cta-mobile">Get in touch</a></li>
    </ul>
  </nav>
</header>

<style>
  .skip-link {
    position: absolute; left: 8px; top: -60px; z-index: 100;
    padding: .5rem .9rem; border-radius: var(--radius-sm);
    background: var(--brand); color: var(--brand-contrast);
    font-size: var(--fs-sm); font-weight: 600; text-decoration: none;
    transition: top .15s ease;
  }
  .skip-link:focus { top: 8px; }
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--s-3);
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  /* Brand */
  .brand {
    display: inline-flex; align-items: center; gap: .6rem;
    color: var(--text); text-decoration: none; white-space: nowrap;
    margin-right: auto; /* the single source of alignment */
  }
  .brand-mark {
    display: inline-grid; place-items: center;
    width: 30px; height: 30px;
    border-radius: var(--radius-sm);
    background: var(--brand);
    color: var(--brand-contrast);
    font-family: var(--font-sans);
    font-weight: 700; font-size: .72rem; letter-spacing: .02em;
  }
  .brand-name { font-weight: 700; font-size: 1rem; letter-spacing: -0.01em; }
  .brand:hover .brand-name { color: var(--brand); }

  /* Desktop nav */
  .nav-desktop ul {
    display: flex; align-items: center; gap: .15rem;
    list-style: none; margin: 0; padding: 0;
  }
  .nav-link {
    display: inline-flex; align-items: center;
    padding: .4rem .7rem; border-radius: var(--radius-sm);
    color: var(--text-muted); font-size: var(--fs-sm); font-weight: 500;
    text-decoration: none; transition: color .15s ease, background .15s ease;
  }
  .nav-link:hover { color: var(--text); background: var(--bg-subtle); }
  .nav-link.active { color: var(--brand); font-weight: 600; background: var(--brand-soft); }

  /* Actions */
  .actions { display: flex; align-items: center; gap: .5rem; margin-left: var(--s-2); }
  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: var(--radius-sm);
    border: 1px solid var(--border); background: none;
    color: var(--text-muted); cursor: pointer;
    transition: color .15s ease, background .15s ease, border-color .15s ease;
  }
  .icon-btn:hover { color: var(--text); background: var(--bg-subtle); border-color: var(--border-strong); }

  .menu-btn {
    display: none;
    align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: var(--radius-sm);
    border: 1px solid var(--border); background: none;
    color: var(--text); cursor: pointer;
  }
  .menu-btn .i-close { display: none; }

  /* Mobile menu */
  .nav-mobile { display: none; border-top: 1px solid var(--border); background: var(--bg); }
  .nav-mobile ul {
    list-style: none; margin: 0;
    padding: var(--s-1) var(--s-3) var(--s-3);
    display: flex; flex-direction: column; gap: .15rem;
  }
  .nav-mobile .nav-link { padding: .8rem .75rem; font-size: 1rem; }
  .cta-mobile { margin-top: var(--s-1); width: 100%; }

  @media (max-width: 780px) {
    .nav-desktop, .cta-desktop { display: none; }
    .menu-btn { display: inline-flex; }
    .site-header.is-open .nav-mobile { display: block; }
    .site-header.is-open .menu-btn .i-open { display: none; }
    .site-header.is-open .menu-btn .i-close { display: inline; }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const btn = document.getElementById('menu-btn');
  btn?.addEventListener('click', () => {
    const open = header.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  document.querySelectorAll('.nav-mobile a').forEach((a) =>
    a.addEventListener('click', () => header?.classList.remove('is-open'))
  );
</script>
