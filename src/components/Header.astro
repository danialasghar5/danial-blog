---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/" class="logo">{SITE_TITLE}</a></h2>
		<div class="nav-menu">
			<div class="internal-links">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/projects">Projects</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
			</div>
			<div class="action-items">
				<div class="social-links">
					<a href="https://github.com/withastro/astro" target="_blank" aria-label="GitHub">
						<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20" fill="currentColor">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
						</svg>
					</a>
				</div>
				<ThemeToggle />
			</div>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1.5rem;
		background-color: var(--bg);
		opacity: 0.98;
		border-bottom: 1px solid var(--border);
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		transition: background-color 0.3s ease, border-color 0.3s ease;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
		height: 4.5rem;
	}
	h2 {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	h2 a {
		color: var(--text);
		text-decoration: none;
	}
	.logo {
		transition: color 0.2s ease;
	}
	.logo:hover {
		color: var(--accent);
	}
	.nav-menu {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.internal-links {
		display: flex;
		gap: 0.5rem;
	}
	.internal-links :global(a) {
		padding: 0.5rem 0.75rem;
		color: var(--text-muted);
		border-radius: 6px;
		font-size: 0.95rem;
		font-weight: 500;
		transition: all 0.2s ease;
		border-bottom: none;
	}
	.internal-links :global(a:hover) {
		color: var(--text);
		background-color: var(--bg-subtle);
	}
	.internal-links :global(a.active) {
		color: var(--accent);
		font-weight: 600;
		background-color: var(--bg-subtle);
	}
	.action-items {
		display: flex;
		align-items: center;
		gap: 1rem;
		border-left: 1px solid var(--border);
		padding-left: 1rem;
	}
	.social-links {
		display: flex;
		align-items: center;
	}
	.social-links a {
		color: var(--text-muted);
		display: flex;
		align-items: center;
		transition: color 0.2s ease;
	}
	.social-links a:hover {
		color: var(--text);
	}
	
	@media (max-width: 640px) {
		nav {
			height: auto;
			flex-direction: column;
			padding: 1rem 0;
			gap: 0.75rem;
		}
		.nav-menu {
			width: 100%;
			justify-content: space-between;
			gap: 0.5rem;
		}
		.action-items {
			border-left: none;
			padding-left: 0;
			gap: 0.75rem;
		}
		.social-links {
			display: none;
		}
	}
</style>
