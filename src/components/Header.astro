---
import ThemeToggle from './ThemeToggle.astro';
import BrandMark from './BrandMark.astro';
import { SITE_TITLE, SOCIALS } from '../consts';
import { liveTopics, topicUrl } from '../data/topics';
import { TOOL_GROUPS, groupById } from '../data/tool-groups';
import { liveTools, toolHref } from '../utils/tools';

const { pathname } = Astro.url;
// Topics is folded into the Writing index, so "Writing" also lights up on the
// /topics/* hub pages. Services is not in this list: it is the header's single
// primary action (the button on the right).
const navLinks = [
  { href: '/blog/', label: 'Writing', match: ['/blog', '/topics'] },
  { href: '/projects/', label: 'Projects' },
  { href: '/tools/', label: 'Tools' },
  { href: '/about/', label: 'About' },
];
// Compare without trailing slashes so '/projects/' also lights up on /projects/<slug>/.
const trim = (p: string) => p.replace(/\/$/, '');
const matches = (paths: string[]) =>
  paths.map(trim).some((p) => trim(pathname) === p || pathname.startsWith(p + '/'));
const isActive = (link: { href: string; match?: string[] }) => matches(link.match ?? [link.href]);
const onServices = matches(['/services']);
// Honeybadger-style topic bar under the header, on the reading pages only.
const showTopicBar = trim(pathname) === '' || matches(['/blog', '/topics']);
// Tools dropdown (TOOLS_ROADMAP.md §12.1): live tools only, grouped by menu
// column, up to 4 per column; empty columns are dropped. Rendered only once at
// least two tools are live, otherwise "Tools" stays a plain link.
const live = await liveTools();
const toolColumns = [...new Set(TOOL_GROUPS.map((g) => g.menuColumn))]
  .map((col) => ({
    col,
    tools: live.filter((t) => groupById(t.data.group).menuColumn === col).slice(0, 4),
  }))
  .filter((c) => c.tools.length > 0);
const showToolsMenu = live.length >= 2;
const topicLinks = [
  { href: '/blog/', label: 'All writing', current: trim(pathname) === '/blog' },
  ...liveTopics().map((t) => ({ href: topicUrl(t.slug), label: t.title, current: matches([topicUrl(t.slug)]) })),
];
---
<a href="#main-content" class="skip-link">Skip to content</a>
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label={`${SITE_TITLE}, home`}>
      <BrandMark size={34} />
      <span class="brand-name">{SITE_TITLE}</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {navLinks.map((l) => (
          <li class:list={[{ 'has-menu': showToolsMenu && l.href === '/tools/' }]}>
            <a
              href={l.href}
              class:list={['nav-link', { active: isActive(l) }]}
              aria-current={isActive(l) ? 'page' : undefined}
            >{l.label}</a>
            {showToolsMenu && l.href === '/tools/' && (
              <>
                <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="tools-menu" aria-label="Show tools">
                  <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
                <div class="tools-menu" id="tools-menu" hidden>
                  <div class="tools-cols">
                    {toolColumns.map((c) => (
                      <div>
                        <p class="tools-col-title">{c.col}</p>
                        <ul>
                          {c.tools.map((t) => <li><a href={toolHref(t.id)}>{t.data.title}</a></li>)}
                        </ul>
                      </div>
                    ))}
                  </div>
                  <div class="tools-foot">
                    <a href="/tools/">All {live.length} tools &rarr;</a>
                    <span>Runs in your browser · nothing uploaded</span>
                  </div>
                </div>
              </>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="icon-btn" href={SOCIALS.github} target="_blank" rel="noopener" aria-label="GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
      <ThemeToggle />
      <a class="btn btn-outline btn-sm header-cta" href="/services/" aria-current={onServices ? 'page' : undefined}>Services</a>
      <button class="menu-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="i-open" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="8" x2="20" y2="8"/><line x1="4" y1="16" x2="20" y2="16"/></svg>
        <svg class="i-close" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile: full-screen sheet under the header bar. -->
  <nav class="nav-mobile" id="mobile-menu" aria-label="Mobile">
    <ul>
      {navLinks.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={['m-link', { active: isActive(l) }]}
            aria-current={isActive(l) ? 'page' : undefined}
          >{l.label}</a>
          {showToolsMenu && l.href === '/tools/' && (
            <ul class="m-sub" aria-label="Tools">
              {live.map((t) => <li><a href={toolHref(t.id)}>{t.data.title}</a></li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <a class="btn btn-primary m-cta" href="/services/" aria-current={onServices ? 'page' : undefined}>Services <span aria-hidden="true">&rarr;</span></a>
  </nav>
</header>
{showTopicBar && (
  <nav class="topic-bar" aria-label="Topics">
    <div class="topic-inner">
      <ul>
        {topicLinks.map((t) => (
          <li><a href={t.href} class:list={['topic-link', { current: t.current }]} aria-current={t.current ? 'page' : undefined}>{t.label}</a></li>
        ))}
      </ul>
      <a class="topic-rss" href="/rss.xml">
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="currentColor"><circle cx="3" cy="13" r="2"/><path d="M1 6.5v2.2A6.3 6.3 0 0 1 7.3 15h2.2A8.5 8.5 0 0 0 1 6.5zm0-4.5v2.2A10.8 10.8 0 0 1 11.8 15H14A13 13 0 0 0 1 2z"/></svg>
        RSS
      </a>
    </div>
  </nav>
)}

<style>
  .skip-link {
    position: absolute; left: 8px; top: -60px; z-index: 100;
    padding: .5rem .9rem; border-radius: var(--radius-sm);
    background: var(--brand); color: var(--brand-contrast);
    font-size: var(--fs-sm); font-weight: 600; text-decoration: none;
    transition: top .15s ease;
  }
  .skip-link:focus { top: 8px; }

  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--space-6);
    height: var(--header-h);
    display: flex; align-items: center; gap: var(--space-6);
  }

  /* Brand lockup: the "da" ligature mark beside the name in heavy ink. */
  .brand {
    display: inline-flex; align-items: center; gap: .6rem;
    color: var(--text); text-decoration: none; white-space: nowrap;
    margin-right: auto;
  }
  .brand-name { font-weight: 800; font-size: 1.25rem; letter-spacing: -0.03em; line-height: 1; }
  .brand:hover .brand-name { color: var(--text); }
  .brand :global(svg) { transition: transform .3s cubic-bezier(.2, .8, .2, 1); }
  .brand:hover :global(svg) { transform: rotate(-8deg) scale(1.06); }

  /* Desktop nav: ink links; the current page gets ruby text and a 2px ruby
     rule sitting on the header's bottom hairline. */
  .nav-desktop ul { display: flex; align-items: center; gap: var(--space-8); list-style: none; margin: 0; padding: 0; }

  /* Tools dropdown: link + disclosure chevron; flat panel separated by hairlines (DESIGN.md: no shadows). */
  .has-menu { position: relative; display: flex; align-items: center; gap: 2px; }
  .menu-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; padding: 0; border: 0; border-radius: var(--radius-sm);
    background: transparent; color: var(--text-muted); cursor: pointer;
  }
  .menu-toggle:hover { color: var(--brand); background: var(--bg-subtle); }
  .menu-toggle:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .menu-toggle svg { transition: transform .15s ease; }
  .menu-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
  .tools-menu {
    position: absolute; top: calc(100% + 14px); left: 50%; transform: translateX(-50%); z-index: 60;
    width: min(44rem, calc(100vw - 2 * var(--space-6)));
    border: 1px solid var(--border-strong); border-radius: var(--radius-lg);
    background: var(--bg);
  }
  .tools-menu[hidden] { display: none; }
  .tools-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: var(--space-6); padding: var(--space-5) var(--space-6); }
  .tools-col-title {
    margin: 0 0 var(--space-2); font-family: var(--font-mono); font-size: var(--fs-xs);
    text-transform: uppercase; letter-spacing: .06em; color: var(--text-faint);
  }
  .tools-menu ul { display: grid; gap: var(--space-2); }
  .tools-menu ul a { font-size: var(--fs-sm); font-weight: 500; color: var(--text); text-decoration: none; }
  .tools-menu ul a:hover { color: var(--brand); }
  .tools-foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-6);
    padding: var(--space-3) var(--space-6); border-top: 1px solid var(--border);
    font-size: var(--fs-xs); color: var(--text-faint);
  }
  .tools-foot a { font-weight: 600; color: var(--brand); text-decoration: none; }
  .m-sub { padding-left: var(--space-4) !important; margin: 0 0 var(--space-2) !important; border-left: 1px solid var(--border); }
  .m-sub a { display: block; padding: var(--space-2) 0; font-size: var(--fs-sm); color: var(--text-muted); text-decoration: none; }
  .m-sub a:hover { color: var(--brand); }
  @media (prefers-reduced-motion: reduce) { .menu-toggle svg { transition: none; } }
  .nav-link {
    position: relative; display: inline-flex; align-items: center;
    height: var(--header-h);
    color: var(--text); font-size: var(--fs-base); font-weight: 500;
    text-decoration: none; transition: color .15s ease;
  }
  .nav-link:hover { color: var(--brand); }
  .nav-link.active { color: var(--brand); }
  .nav-link.active::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -1px;
    height: 2px; background: var(--brand);
  }

  /* Topic bar */
  .topic-bar { border-bottom: 1px solid var(--border); background: var(--bg); }
  .topic-inner {
    max-width: var(--container); margin-inline: auto; padding-inline: var(--space-6);
    display: flex; align-items: center; gap: var(--space-6);
    min-height: 44px;
  }
  .topic-bar ul {
    display: flex; gap: var(--space-6); list-style: none; margin: 0; padding: 0;
    overflow-x: auto; scrollbar-width: none; flex: 1; min-width: 0;
    /* Fade the trailing edge so a clipped topic reads as scrollable. */
    -webkit-mask-image: linear-gradient(to right, #000 85%, transparent);
    mask-image: linear-gradient(to right, #000 85%, transparent);
  }
  @media (min-width: 900px) { .topic-bar ul { -webkit-mask-image: none; mask-image: none; } }
  .topic-bar ul::-webkit-scrollbar { display: none; }
  .topic-link {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--text-faint); font-size: var(--fs-sm); font-weight: 500; white-space: nowrap;
    text-decoration: none;
  }
  .topic-link:hover, .topic-link.current { color: var(--text); }
  .topic-link.current { font-weight: 600; }
  .topic-rss {
    display: inline-flex; align-items: center; gap: .35rem; min-height: 44px;
    color: var(--text-faint); font-size: var(--fs-sm); font-weight: 500; text-decoration: none; white-space: nowrap;
  }
  .topic-rss:hover { color: var(--brand); }

  /* Actions */
  .actions { display: flex; align-items: center; gap: var(--space-1); }
  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: var(--radius-sm);
    color: var(--text-muted);
    transition: color .15s ease, background .15s ease;
  }
  .icon-btn:hover { color: var(--text); background: var(--bg-subtle); }
  .header-cta { margin-left: var(--space-3); }

  .menu-btn {
    display: none; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: var(--radius-sm);
    border: 0; background: none; color: var(--text); cursor: pointer;
  }
  .menu-btn:hover { background: var(--bg-subtle); }
  .menu-btn .i-close { display: none; }

  /* Mobile sheet */
  .nav-mobile {
    display: none;
    position: fixed; inset: var(--header-h) 0 0 0; z-index: 49;
    background: var(--bg);
    padding: var(--space-4) var(--space-6) var(--space-10);
    overflow-y: auto;
    flex-direction: column; gap: var(--space-8);
  }
  .nav-mobile ul { list-style: none; margin: 0; padding: 0; }
  .nav-mobile li { border-bottom: 1px solid var(--border); }
  .m-link {
    display: block; padding: var(--space-4) 0;
    font-size: var(--fs-2xl); font-weight: 800; letter-spacing: var(--tracking-tight);
    color: var(--text); text-decoration: none;
  }
  .m-link.active { color: var(--brand); }
  .m-cta { justify-content: center; padding-block: .9rem; font-size: var(--fs-base); }

  /* Narrow phones (≤360px): brand + three 44px buttons overflow 320px. Tighten
     spacing and drop the GitHub icon here; it stays in the footer. */
  @media (max-width: 360px) {
    .header-inner { padding-inline: var(--space-4); gap: var(--space-3); }
    .brand-name { font-size: 1.125rem; }
    .actions a.icon-btn { display: none; }
  }
  @media (max-width: 780px) {
    .nav-desktop, .header-cta { display: none; }
    .menu-btn { display: inline-flex; }
    .site-header.is-open .nav-mobile { display: flex; }
    .site-header.is-open .menu-btn .i-open { display: none; }
    .site-header.is-open .menu-btn .i-close { display: inline; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const btn = document.getElementById('menu-btn');
  const setOpen = (open: boolean) => {
    header?.classList.toggle('is-open', open);
    // Lock page scroll behind the full-screen sheet.
    document.documentElement.style.overflow = open ? 'hidden' : '';
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  btn?.addEventListener('click', () => setOpen(!header?.classList.contains('is-open')));
  document.querySelectorAll('.nav-mobile a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('is-open')) { setOpen(false); btn?.focus(); }
  });
  // Leaving the mobile breakpoint with the sheet open must not leave the page locked.
  matchMedia('(min-width: 781px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });

  // Tools dropdown: a disclosure button next to the "Tools" link. Click/Enter
  // toggles; Escape closes and returns focus; clicking or tabbing out closes.
  const toolsItem = document.querySelector<HTMLElement>('.has-menu');
  const toolsBtn = toolsItem?.querySelector<HTMLButtonElement>('.menu-toggle');
  const toolsMenu = document.getElementById('tools-menu');
  const setTools = (open: boolean) => {
    if (!toolsBtn || !toolsMenu) return;
    toolsMenu.hidden = !open;
    toolsBtn.setAttribute('aria-expanded', String(open));
    toolsBtn.setAttribute('aria-label', open ? 'Hide tools' : 'Show tools');
  };
  toolsBtn?.addEventListener('click', () => setTools(toolsMenu?.hidden ?? false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toolsMenu && !toolsMenu.hidden) { setTools(false); toolsBtn?.focus(); }
  });
  document.addEventListener('click', (e) => {
    if (toolsItem && toolsMenu && !toolsMenu.hidden && !toolsItem.contains(e.target as Node)) setTools(false);
  });
  toolsItem?.addEventListener('focusout', (e) => {
    if (!toolsItem.contains(e.relatedTarget as Node | null)) setTools(false);
  });
</script>
