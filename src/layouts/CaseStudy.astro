---
import Page from './Page.astro';
import type { CollectionEntry } from 'astro:content';
import { SITE_TITLE } from '../consts';
import { breadcrumbJsonLd } from '../utils/breadcrumbs';

type Data = CollectionEntry<'projects'>['data'];
interface Props extends Data {}

const {
	title,
	problem,
	role,
	timeframe,
	tech = [],
	liveUrl,
	repoUrl,
	highlights = [],
	metrics = [],
} = Astro.props;

const meta = [role, timeframe].filter(Boolean);
---

<Page title={`${title} — ${SITE_TITLE}`} description={problem} type="article">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd([{ label: 'Home', href: '/' }, { label: 'Projects', href: '/projects/' }, { label: title }], Astro.site, Astro.url))} is:inline />
	</Fragment>
	<article class="case-study reading-column">
		<a class="back" href="/projects/">&larr; Projects</a>

		<header class="cs-header">
			<h1 class="cs-title">{title}</h1>
			<p class="cs-problem">{problem}</p>
			{meta.length > 0 && (
				<p class="cs-meta">
					{meta.map((m, i) => <>{i > 0 && <span class="dot" aria-hidden="true">·</span>}<span>{m}</span></>)}
				</p>
			)}
			{tech.length > 0 && <p class="cs-tech"><span class="label">Stack</span> {tech.join(', ')}</p>}
			{(liveUrl || repoUrl) && (
				<p class="cs-links">
					{liveUrl && <a href={liveUrl} target="_blank" rel="noopener">View live <span aria-hidden="true">&nearr;</span></a>}
					{repoUrl && <a href={repoUrl} target="_blank" rel="noopener">Source <span aria-hidden="true">&nearr;</span></a>}
				</p>
			)}
		</header>

		{metrics.length > 0 && (
			<ul class="cs-metrics">
				{metrics.map((m) => (
					<li>
						<span class="m-value">{m.value}</span>
						<span class="m-label">{m.label}</span>
					</li>
				))}
			</ul>
		)}

		{highlights.length > 0 && (
			<section class="cs-highlights" aria-labelledby="cs-highlights-h">
				<h2 id="cs-highlights-h">Highlights</h2>
				<ul>{highlights.map((h) => <li>{h}</li>)}</ul>
			</section>
		)}

		<div class="prose">
			<slot />
		</div>
	</article>
</Page>

<style>
	/* Full-width main; the article itself is the centred .reading-column. */
	main { padding: var(--space-12) var(--space-6) var(--space-8); }

	.back {
		display: inline-block; margin-bottom: var(--space-10);
		font-size: var(--fs-sm); color: var(--text-muted); text-decoration: none;
	}
	.back:hover { color: var(--text); }

	.cs-header { margin-bottom: var(--space-10); }
	.cs-title {
		font-size: var(--fs-4xl); font-weight: 700;
		letter-spacing: var(--tracking-tighter); line-height: var(--lh-tight);
		margin: 0 0 var(--space-5);
	}
	.cs-problem {
		font-family: var(--font-prose);
		font-size: var(--fs-xl); line-height: var(--lh-normal); color: var(--text-muted);
		margin: 0 0 var(--space-6);
	}
	.cs-meta, .cs-tech {
		display: flex; flex-wrap: wrap; gap: .25rem .5rem;
		margin: 0 0 var(--space-2); font-size: var(--fs-sm); color: var(--text-faint);
	}
	.cs-tech { display: block; color: var(--text-muted); }
	.cs-tech .label { color: var(--text-faint); margin-right: .35rem; }
	.cs-links { display: flex; flex-wrap: wrap; gap: var(--space-6); margin: var(--space-4) 0 0; font-size: var(--fs-sm); font-weight: 600; }
	.cs-links a { color: var(--brand); text-decoration: none; }
	.cs-links a:hover { color: var(--brand-hover); text-decoration: underline; text-underline-offset: 3px; }

	/* Metrics (only when real numbers exist): figures on a hairline row. */
	.cs-metrics {
		display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: var(--space-6);
		list-style: none; margin: 0 0 var(--space-10); padding: var(--space-6) 0;
		border-block: 1px solid var(--border);
	}
	.cs-metrics li { display: flex; flex-direction: column; gap: .15rem; }
	.m-value { font-size: var(--fs-2xl); font-weight: 600; letter-spacing: var(--tracking-tight); font-variant-numeric: tabular-nums; }
	.m-label { font-size: var(--fs-sm); color: var(--text-muted); }

	/* Highlights: a short list between hairlines. */
	.cs-highlights { margin-bottom: var(--space-12); padding-block: var(--space-6); border-block: 1px solid var(--border); }
	.cs-highlights h2 { font-size: var(--fs-sm); font-weight: 600; margin: 0 0 var(--space-3); }
	.cs-highlights ul { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: .5rem; }
	.cs-highlights li { color: var(--text); font-size: var(--fs-sm); line-height: var(--lh-normal); }
	.cs-highlights li::marker { color: var(--text-faint); }

	@media (max-width: 560px) {
		.cs-problem { font-size: var(--fs-lg); }
	}
</style>
