---
import Page from './Page.astro';
import type { CollectionEntry } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_TITLE } from '../consts';

type Data = CollectionEntry<'projects'>['data'];
interface Props extends Data {}

const {
	title,
	problem,
	role,
	timeframe,
	tech = [],
	liveUrl,
	repoUrl,
	highlights = [],
	metrics = [],
} = Astro.props;

const meta = [role, timeframe].filter(Boolean);
---

<Page title={`${title} — ${SITE_TITLE}`} description={problem} type="article">
	<article class="case-study">
		<Breadcrumbs items={[
			{ label: 'Home', href: '/' },
			{ label: 'Projects', href: '/projects' },
			{ label: title },
		]} />

		<header class="cs-header">
			<h1 class="cs-title">{title}</h1>
			<p class="cs-problem">{problem}</p>

			{meta.length > 0 && (
				<div class="cs-meta">
					{meta.map((m) => <span class="meta-item">{m}</span>)}
				</div>
			)}

			{tech.length > 0 && (
				<ul class="cs-tech">
					{tech.map((t) => <li class="chip">{t}</li>)}
				</ul>
			)}

			{(liveUrl || repoUrl) && (
				<div class="cs-links">
					{liveUrl && <a class="btn btn-primary btn-sm" href={liveUrl} target="_blank" rel="noopener">View live ↗</a>}
					{repoUrl && <a class="btn btn-secondary btn-sm" href={repoUrl} target="_blank" rel="noopener">Source ↗</a>}
				</div>
			)}
		</header>

		{metrics.length > 0 && (
			<ul class="cs-metrics">
				{metrics.map((m) => (
					<li>
						<span class="m-value">{m.value}</span>
						<span class="m-label">{m.label}</span>
					</li>
				))}
			</ul>
		)}

		{highlights.length > 0 && (
			<section class="cs-highlights" aria-label="Highlights">
				<h2>Highlights</h2>
				<ul>{highlights.map((h) => <li>{h}</li>)}</ul>
			</section>
		)}

		<div class="prose">
			<slot />
		</div>

		<div class="back-row">
			<a href="/projects" class="back-link">← Back to Projects</a>
		</div>
	</article>
</Page>

<style>
	main {
		max-width: var(--container-prose);
		margin-inline: auto;
		padding: var(--space-12) var(--space-6) var(--space-8);
	}
	/* Centered reading column; text, code, images, and tables all share it. */
	.case-study { display: flex; flex-direction: column; gap: var(--space-8); }

	/* Header */
	.cs-header { display: flex; flex-direction: column; gap: var(--space-4); }
	.cs-title {
		font-size: var(--fs-4xl); font-weight: 800;
		letter-spacing: var(--tracking-tighter); line-height: var(--lh-tight); margin: 0;
	}
	.cs-problem { font-size: var(--fs-lg); color: var(--text-muted); line-height: var(--lh-normal); margin: 0; }
	.cs-meta {
		display: flex; flex-wrap: wrap; align-items: center; gap: .5rem var(--space-4);
		font-size: var(--fs-sm); color: var(--text-muted); padding-top: var(--space-2);
	}
	.meta-item { display: inline-flex; align-items: center; }
	.meta-item + .meta-item::before { content: '·'; margin-right: var(--space-4); color: var(--text-faint); }
	.cs-tech { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: var(--space-2) 0 0; padding: 0; }
	.cs-links { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: var(--space-4); }

	/* Metrics (only when real numbers are provided) */
	.cs-metrics {
		display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: var(--space-4); list-style: none; margin: var(--space-2) 0 0; padding: 0;
	}
	.cs-metrics li {
		display: flex; flex-direction: column; gap: .15rem;
		padding: var(--space-6);
		border: 1px solid var(--border); border-radius: var(--radius-lg);
		background: var(--card-bg);
	}
	.m-value { font-family: var(--font-sans); font-size: var(--fs-2xl); font-weight: 700; letter-spacing: var(--tracking-tight); }
	.m-label { font-size: var(--fs-sm); color: var(--text-muted); }

	/* Highlights box */
	.cs-highlights {
		border: 1px solid var(--border); border-radius: var(--radius-lg);
		background: var(--bg-subtle); padding: var(--space-6) var(--space-8);
	}
	.cs-highlights h2 {
		font-size: var(--fs-sm); text-transform: uppercase; letter-spacing: .06em;
		color: var(--text-muted); margin: 0 0 var(--space-4);
	}
	.cs-highlights ul { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: .4rem; }
	.cs-highlights li { color: var(--text); font-size: var(--fs-sm); line-height: var(--lh-normal); }

	.back-row { margin-top: var(--space-8); padding-top: var(--space-8); border-top: 1px solid var(--border); }
	.back-link { font-weight: 600; font-size: var(--fs-sm); color: var(--text-muted); }
	.back-link:hover { color: var(--brand); }
</style>
