---
import Page from './Page.astro';
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Newsletter from '../components/Newsletter.astro';
import ServicesCta from '../components/ServicesCta.astro';
import { readingTime } from '../utils/reading-time';
import { getTopic, topicUrl } from '../data/topics';

type PostLink = { slug: string; title: string } | null;
type Heading = { depth: number; slug: string; text: string };

interface Props {
	id?: string;
	title: string;
	seoTitle?: string;
	seoDescription?: string;
	ogImage?: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: CollectionEntry<'blog'>['data']['heroImage'];
	tags?: string[];
	category?: string;
	readingTime?: string;
	headings?: Heading[];
	prevPost?: PostLink;
	nextPost?: PostLink;
	hasCustomSchema?: boolean;
}

const {
	id,
	title,
	seoTitle,
	seoDescription,
	ogImage,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	category,
	readingTime: readingTimeLabel,
	headings = [],
	prevPost = null,
	nextPost = null,
	hasCustomSchema = false,
} = Astro.props;

// Inline contents: H2 + H3 only. Shown when a post has enough structure to be
// worth navigating (avoids a one-item list on short posts).
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 3;

// Related reading: other posts in the same topic hub, newest first, up to 3.
const topic = getTopic(category);
const related = category
	? (await getCollection('blog'))
			.filter((p) => !p.data.draft && p.data.category === category && p.id !== id)
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
			.slice(0, 3)
	: [];

// Keyword-first SEO title. The brand suffix is added only when the whole title
// still fits Google's ~60-character display; otherwise it would push the keyword
// text into the truncated "…" (Google shows the site name separately anyway).
const baseTitle = seoTitle ?? title;
const BRAND_SUFFIX = ' — Danial Asghar';
const pageTitle = baseTitle.length + BRAND_SUFFIX.length <= 60 ? baseTitle + BRAND_SUFFIX : baseTitle;

// Show "Updated" only when the post was genuinely revised on a later calendar
// day than it was published (compared in UTC, matching our date semantics).
const showUpdated =
	!!updatedDate &&
	updatedDate.toISOString().slice(0, 10) > pubDate.toISOString().slice(0, 10);
---

<Page title={pageTitle} description={seoDescription ?? description} type="article" suppressArticleSchema={hasCustomSchema} ogImageUrl={ogImage} pubDate={pubDate} updatedDate={updatedDate}>
	<Fragment slot="before-main">
		<div class="read-progress" aria-hidden="true"><span id="read-progress-bar"></span></div>
	</Fragment>
	<article class="blog-post reading-column">
		<a class="back" href="/blog/">&larr; Writing</a>

		<header class="post-header">
			<h1 class="post-title">{title}</h1>
			{description && <p class="post-desc">{description}</p>}
			<p class="post-meta">
				{topic && (topic.live
					? <a class="meta-topic" href={topicUrl(topic.slug)}>{topic.title}</a>
					: <span class="meta-topic">{topic.title}</span>)}
				{topic && <span class="dot" aria-hidden="true">·</span>}
				<FormattedDate date={pubDate} />
				{readingTimeLabel && <span class="dot" aria-hidden="true">·</span>}
				{readingTimeLabel && <span>{readingTimeLabel}</span>}
				{showUpdated && <span class="dot" aria-hidden="true">·</span>}
				{showUpdated && <span class="meta-updated">Updated <FormattedDate date={updatedDate} /></span>}
			</p>
		</header>

		{heroImage && (
			<div class="hero-image">
				<Image width={1080} height={540} src={heroImage} alt={`Cover for ${title}`} />
			</div>
		)}

		{showToc && (
			<details class="contents" open>
				<summary>Contents</summary>
				<ol>
					{toc.map((h) => (
						<li class:list={[{ sub: h.depth === 3 }]}><a href={`#${h.slug}`}>{h.text}</a></li>
					))}
				</ol>
			</details>
		)}
		{showToc && (
			<script is:inline>
				// Open by default on wide screens; collapsed on phones so the article
				// starts above the fold. Runs during parse, so there is no flash.
				if (matchMedia('(max-width: 719px)').matches) document.currentScript.previousElementSibling.open = false;
			</script>
		)}

		<div class="prose">
			<slot />
		</div>

		<footer class="post-foot">
			<ServicesCta category={category} />

			{related.length > 0 && (
				<aside class="related" aria-labelledby="related-head">
					<h2 class="foot-head" id="related-head">More in {topic?.title ?? 'this topic'}</h2>
					<ul class="related-list">
						{related.map((p) => (
							<li>
								<a class="related-link" href={`/blog/${p.id}/`}>
									<span class="related-title">{p.data.title}</span>
									<span class="related-meta"><FormattedDate date={p.data.pubDate} /> · {readingTime(p.body)}</span>
								</a>
							</li>
						))}
					</ul>
				</aside>
			)}

			{(prevPost || nextPost) && (
				<nav class="post-nav" aria-label="More posts">
					{prevPost ? (
						<a class="post-nav-link prev" href={`/blog/${prevPost.slug}/`}>
							<span class="dir">&larr; Previous</span>
							<span class="t">{prevPost.title}</span>
						</a>
					) : <span />}
					{nextPost ? (
						<a class="post-nav-link next" href={`/blog/${nextPost.slug}/`}>
							<span class="dir">Next &rarr;</span>
							<span class="t">{nextPost.title}</span>
						</a>
					) : <span />}
				</nav>
			)}
		</footer>
	</article>

	<script>
		// Reading-progress bar: a thin fill under the header tracking how far
		// through the article you are.
		const bar = document.getElementById('read-progress-bar');
		const article = document.querySelector('.blog-post');
		function onScroll() {
			if (!bar || !article) return;
			const rect = article.getBoundingClientRect();
			const total = rect.height - window.innerHeight;
			const scrolled = Math.min(Math.max(-rect.top, 0), Math.max(total, 0));
			bar.style.width = (total > 0 ? (scrolled / total) * 100 : 0) + '%';
		}
		addEventListener('scroll', onScroll, { passive: true });
		addEventListener('resize', onScroll, { passive: true });
		onScroll();
	</script>
	<Fragment slot="after-main">
		<Newsletter />
	</Fragment>
</Page>

<style>
	/* Full-width main; the article itself is the centred .reading-column. */
	main { padding: var(--space-12) var(--space-6) var(--space-8); }

	.read-progress {
		position: fixed; top: var(--header-h); left: 0; right: 0; height: 2px;
		z-index: 40; pointer-events: none;
	}
	.read-progress span { display: block; height: 100%; width: 0; background: var(--brand); }

	.back {
		display: inline-block; margin-bottom: var(--space-10);
		font-size: var(--fs-sm); color: var(--text-muted); text-decoration: none;
	}
	.back:hover { color: var(--text); }

	/* Header: title, summary, one meta line. */
	.post-header { margin-bottom: var(--space-10); }
	.post-title {
		font-size: var(--fs-4xl); font-weight: 700;
		letter-spacing: var(--tracking-tighter); line-height: var(--lh-tight);
		margin: 0 0 var(--space-5);
	}
	.post-desc {
		font-family: var(--font-prose);
		font-size: var(--fs-xl); line-height: var(--lh-normal); color: var(--text-muted);
		margin: 0 0 var(--space-6);
	}
	.post-meta {
		display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .5rem;
		margin: 0; font-size: var(--fs-sm); color: var(--text-faint);
		font-variant-numeric: tabular-nums;
	}
	.meta-topic { color: var(--text-muted); font-weight: 500; text-decoration: none; }
	a.meta-topic:hover { color: var(--brand); }
	.meta-updated { color: var(--text-muted); }

	.hero-image { margin-bottom: var(--space-10); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); aspect-ratio: 2 / 1; }
	.hero-image :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

	/* Inline contents: between hairlines; two columns on wide screens. */
	.contents {
		margin-bottom: var(--space-12);
		padding-block: var(--space-4);
		border-block: 1px solid var(--border);
	}
	.contents > summary {
		cursor: pointer; list-style: none;
		display: flex; align-items: center; gap: .5rem;
		font-size: var(--fs-sm); font-weight: 600; color: var(--text);
	}
	.contents > summary::-webkit-details-marker { display: none; }
	.contents > summary::after {
		content: ''; width: 6px; height: 6px; margin-left: 2px;
		border-right: 1.5px solid var(--text-faint); border-bottom: 1.5px solid var(--text-faint);
		transform: rotate(-45deg); transition: transform .15s ease;
	}
	.contents[open] > summary::after { transform: rotate(45deg) translate(-2px, -2px); }
	.contents ol { list-style: none; margin: var(--space-3) 0 0; padding: 0; }
	@media (min-width: 720px) { .contents ol { columns: 2; column-gap: var(--space-8); } }
	.contents li { break-inside: avoid; }
	.contents li.sub { padding-left: var(--space-4); }
	.contents a {
		display: block; padding: .3rem 0;
		font-size: var(--fs-sm); line-height: var(--lh-snug);
		color: var(--text-muted); text-decoration: none;
	}
	.contents li.sub a { font-size: var(--fs-xs); }
	.contents a:hover { color: var(--brand); }

	/* Foot: services note, related posts, previous/next — hairline rows. */
	.post-foot { margin-top: var(--space-16); display: flex; flex-direction: column; }
	.related { padding-top: var(--space-8); border-top: 1px solid var(--border); }
	.foot-head { font-size: var(--fs-sm); font-weight: 600; margin: 0 0 var(--space-2); }
	.related-list { list-style: none; margin: 0; padding: 0; }
	.related-link {
		display: flex; flex-direction: column; gap: .2rem;
		padding: var(--space-4) 0; border-bottom: 1px solid var(--border);
		text-decoration: none; color: var(--text);
	}
	.related-list li:last-child .related-link { border-bottom: 0; }
	.related-title { font-weight: 600; font-size: var(--fs-base); line-height: var(--lh-snug); }
	.related-link:hover .related-title { color: var(--brand); }
	.related-meta { font-size: var(--fs-xs); color: var(--text-faint); }

	.post-nav {
		display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8);
		margin-top: var(--space-8); padding-top: var(--space-8);
		border-top: 1px solid var(--border);
	}
	.post-nav-link { display: flex; flex-direction: column; gap: .35rem; text-decoration: none; color: var(--text); }
	.post-nav-link.next { text-align: right; }
	.post-nav-link .dir { font-size: var(--fs-xs); color: var(--text-faint); }
	.post-nav-link .t { font-weight: 600; font-size: var(--fs-sm); line-height: var(--lh-snug); }
	.post-nav-link:hover .t { color: var(--brand); }

	@media (max-width: 560px) {
		.post-desc { font-size: var(--fs-lg); }
		.post-nav { grid-template-columns: 1fr; gap: var(--space-6); }
		.post-nav-link.next { text-align: left; }
	}
</style>
