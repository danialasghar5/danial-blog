---
import Page from '../layouts/Page.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { BOOKING_URL, EMAIL } from '../consts';

// ── EDIT ME ────────────────────────────────────────────────────────────────
// `price` is shown as "Starting at …". Empty string = hidden (no placeholder
// prices ever ship). Booking link lives in consts.ts (BOOKING_URL).
const offers = [
	{
		name: 'Background Job Reliability Audit',
		price: '$1,000',
		summary:
			'Why your jobs run twice, lose data, or pile up — diagnosed against your real code, with a prioritized remediation plan. Fixed scope, delivered in one week.',
		includes: [
			'Idempotency & duplicate-execution review',
			'Retry, backoff & dead-set strategy',
			'Prioritized, code-level fix plan',
		],
	},
	{
		name: 'Sidekiq / Solid Queue Scaling & Tuning',
		price: '$2,000',
		summary:
			'Throughput, queue latency, connection-pool exhaustion, and retry-storm remediation for production queues under real load.',
		includes: [
			'Worker/thread & connection-pool sizing',
			'Queue latency vs execution-time diagnosis',
			'Backend selection & migration guidance',
		],
	},
	{
		name: 'Postgres Concurrency & Lock Review',
		price: '$3,000',
		summary: 'Race conditions, locking, and deadlocks — found and fixed before they corrupt data.',
		includes: [
			'Race-condition & locking audit',
			'Transaction isolation & deadlock analysis',
			'Safe-concurrency patterns for your schema',
		],
	},
];

// Proof strip — keep to claims you can verify today (GSC positions drift).
const proof = {
	ranking: 'Ranked #1–6',
	featured: ['Ruby Weekly', 'RubyFlow'],
};
// ────────────────────────────────────────────────────────────────────────────

const mailto = `mailto:${EMAIL}?subject=${encodeURIComponent('Rails reliability inquiry')}`;
const bookHref = BOOKING_URL || mailto;
const bookExternal = BOOKING_URL.startsWith('http');

const steps = [
	'A short call to scope the problem and confirm fit.',
	'A focused audit of your code, config, and production behavior.',
	'A prioritized written report and the fixes that matter most.',
];

const site = Astro.site?.toString() ?? 'https://danialasghar.com/';
const serviceJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	serviceType: 'Rails Reliability Engineering Consulting',
	provider: { '@id': `${site}#person` },
	areaServed: 'Worldwide',
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Rails Reliability Services',
		itemListElement: offers.map((o) => ({
			'@type': 'Offer',
			itemOffered: { '@type': 'Service', name: o.name, description: o.summary },
		})),
	},
};
---

<Page title="Rails Reliability Consulting — Background Jobs, Sidekiq, Postgres"
	description="Fixed-scope audits and tuning for production Rails: background-job reliability, Sidekiq/Solid Queue scaling, and Postgres concurrency reviews." mainClass="container">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} is:inline />
	</Fragment>
	<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />

	<!-- Hero: the client's problem, not a job title -->
	<PageHeader class="hero" eyebrow="Rails Reliability Consulting" title="Your Rails background jobs are double-charging customers, losing data, or backing up under load.">
		<p class="page-lede lede">
			I find the root cause and give you a prioritized fix plan — fast, fixed-scope, and
			grounded in the exact reliability work I <a href="/blog/">write about</a>.
		</p>
		<a class="btn btn-primary big" href={bookHref} {...bookExternal && { target: '_blank', rel: 'noopener' }}>
			{bookExternal ? 'Book a 20-min intro call' : 'Email me about your system'} <span aria-hidden="true">&rarr;</span>
		</a>
	</PageHeader>

	<!-- Proof strip -->
	<p class="proof">
		{proof.ranking} on Google for <a href="/blog/solid-queue-vs-sidekiq/">Sidekiq &amp; Solid Queue reliability</a> · Featured
		in {proof.featured.join(' & ')}
	</p>

	<!-- Productized offers -->
	<section class="block" aria-labelledby="offers-h">
		<div class="section-head"><h2 id="offers-h">How I can help</h2></div>
		<div class="offers">
			{offers.map((o) => (
				<article class="offer">
					<h3>{o.name}</h3>
					{o.price && <p class="price"><span class="from">Starting at</span> <span class="amount">{o.price}</span></p>}
					<p class="offer-summary">{o.summary}</p>
					<ul class="offer-list">{o.includes.map((i) => <li>{i}</li>)}</ul>
				</article>
			))}
		</div>
	</section>

	<!-- How it works -->
	<section class="block" aria-labelledby="how-h">
		<div class="section-head"><h2 id="how-h">How it works</h2></div>
		<ol class="steps">
			{steps.map((s, i) => (
				<li>
					<span class="step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
					<p>{s}</p>
				</li>
			))}
		</ol>
	</section>

	<!-- Who it's for -->
	<section class="fit">
		<div>
			<h3 class="fit-yes">A good fit for</h3>
			<p>Production Rails teams doing real volume, hitting reliability or concurrency issues under load.</p>
		</div>
		<div>
			<h3 class="fit-no">Not a fit for</h3>
			<p>Pre-launch MVPs or teams looking for generic Rails feature development.</p>
		</div>
	</section>

	<!-- Final CTA -->
	<section class="final">
		<h2>Have a reliability problem in production?</h2>
		<p>Tell me what's breaking. If I can help, I'll say how; if I can't, I'll point you to who can.</p>
		<a class="btn btn-primary big" href={bookHref} {...bookExternal && { target: '_blank', rel: 'noopener' }}>
			{bookExternal ? 'Book an intro call' : 'Email me'} <span aria-hidden="true">&rarr;</span>
		</a>
		{bookExternal && (
			<p class="alt">Prefer email? <a href={mailto}>{EMAIL}</a></p>
		)}
	</section>
</Page>

<style>
	main { padding-block: var(--space-16) var(--space-8); }

	.hero { max-width: 760px; padding-bottom: var(--space-10); }
	.lede { margin: 0 0 var(--space-8); max-width: 62ch; }
	.lede a, .proof a, .alt a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--border-strong); }
	.lede a:hover, .proof a:hover, .alt a:hover { color: var(--brand); text-decoration-color: var(--brand); }
	.big { padding: .8rem 1.4rem; font-size: var(--fs-base); }

	.proof {
		margin: 0; padding: var(--space-4) 0;
		border-block: 1px solid var(--border);
		font-size: var(--fs-sm); color: var(--text-muted);
	}

	.block { padding-top: var(--space-16); }

	/* Offers: three columns divided by vertical hairlines (stacked rows on
	   narrow screens). The price is the largest number on the page. */
	.offers { display: grid; grid-template-columns: 1fr; border-bottom: 1px solid var(--border); }
	@media (min-width: 900px) { .offers { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
	.offer {
		display: flex; flex-direction: column; gap: var(--space-4);
		padding: var(--space-8) 0;
		border-top: 1px solid var(--border);
	}
	.offers > .offer:first-child { border-top: 0; }
	@media (min-width: 900px) {
		/* Subgrid: name, price, summary and checklist line up across columns
		   even when one offer's name wraps to two lines. */
		.offers { grid-template-rows: repeat(4, auto); }
		.offer { display: grid; grid-row: span 4; grid-template-rows: subgrid; align-content: start; row-gap: var(--space-4); }
		.offer { padding: var(--space-2) var(--space-8) var(--space-8); border-top: 0; }
		.offer:first-child { padding-left: 0; }
		.offer:last-child { padding-right: 0; }
		.offer + .offer { border-left: 1px solid var(--border); }
	}
	.offer h3 { font-size: var(--fs-lg); font-weight: 600; line-height: var(--lh-snug); margin: 0; }
	.price { margin: 0; display: flex; flex-direction: column; gap: .15rem; }
	.price .from { font-size: var(--fs-xs); color: var(--text-faint); }
	.price .amount { font-size: var(--fs-3xl); font-weight: 600; letter-spacing: var(--tracking-tighter); line-height: 1; font-variant-numeric: tabular-nums; }
	.offer-summary { margin: 0; font-size: var(--fs-sm); color: var(--text-muted); line-height: var(--lh-normal); }
	.offer-list { margin: 0; align-self: start; padding: var(--space-4) 0 0; border-top: 1px solid var(--border); list-style: none; display: flex; flex-direction: column; gap: .45rem; }
	.offer-list li { font-size: var(--fs-sm); color: var(--text); padding-left: 1.1rem; position: relative; }
	.offer-list li::before { content: '✓'; position: absolute; left: 0; color: var(--brand); font-weight: 700; }

	/* How it works: a numbered list of hairline rows. */
	.steps { list-style: none; margin: 0; padding: 0; }
	.steps li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); align-items: baseline; padding: var(--space-5) 0; border-top: 1px solid var(--border); }
	.steps li:first-child { border-top: 0; }
	.step-n { font-family: var(--font-mono); font-size: var(--fs-sm); color: var(--text-faint); }
	.steps p { margin: 0; font-size: var(--fs-base); color: var(--text); line-height: var(--lh-normal); }

	/* Fit: two plain columns under a hairline. */
	.fit {
		margin-top: var(--space-16); padding-top: var(--space-8);
		display: grid; gap: var(--space-8); grid-template-columns: 1fr;
		border-top: 1px solid var(--border);
	}
	@media (min-width: 720px) { .fit { grid-template-columns: 1fr 1fr; } }
	.fit h3 { font-size: var(--fs-sm); font-weight: 600; margin: 0 0 var(--space-2); }
	.fit-yes { color: var(--text); }
	.fit-no { color: var(--text-faint); }
	.fit p { margin: 0; font-size: var(--fs-base); color: var(--text-muted); line-height: var(--lh-normal); max-width: 52ch; }

	.final { margin-top: var(--space-16); padding-top: var(--space-16); border-top: 1px solid var(--border); text-align: center; }
	.final h2 { font-size: var(--fs-2xl); font-weight: 600; margin: 0 0 var(--space-2); letter-spacing: var(--tracking-tight); }
	.final > p { color: var(--text-muted); max-width: 52ch; margin: 0 auto var(--space-6); line-height: var(--lh-normal); }
	.alt { margin-top: var(--space-4) !important; font-size: var(--fs-sm); }
</style>
