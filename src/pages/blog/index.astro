---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostListItem from '../../components/PostListItem.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE_TITLE } from '../../consts';
import { liveTopics, getTopic } from '../../data/topics';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Topic filter — only surface hubs that actually have posts here (folds the old
// standalone "Topics" nav item into the writing index).
const usedCategories = new Set(posts.map((p) => p.data.category).filter(Boolean));
const topics = liveTopics().filter((t) => usedCategories.has(t.slug));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writing — ${SITE_TITLE}`} description="Production-grounded writing on Rails architecture, background processing, database reliability, and AI-powered backends." />
	</head>
	<body>
		<Header />
		<main id="main-content" class="container">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Writing' }]} />
			<div class="blog-header">
				<p class="eyebrow">Writing</p>
				<h1 class="blog-title">Notes on shipping production software</h1>
				<p class="blog-subtitle">Deep dives on Rails architecture, background processing, database reliability, and AI-powered backends — each one grounded in systems I build and ship.</p>
			</div>

			{posts.length === 0 ? (
				<p class="no-posts">Articles are on the way — deep dives on backend architecture, async pipelines, and AI systems. Check back soon.</p>
			) : (
				<>
					{topics.length > 1 && (
						<div class="filters" role="tablist" aria-label="Filter writing by topic">
							<button class="filter active" data-cat="all" role="tab" aria-selected="true">All</button>
							{topics.map((t) => (
								<button class="filter" data-cat={t.slug} role="tab" aria-selected="false">{t.title}</button>
							))}
						</div>
					)}

					<section class="post-list" id="post-list">
						{posts.map((post) => <PostListItem post={post} />)}
					</section>
					<p class="empty" id="empty-state" hidden>No posts in that topic yet.</p>
				</>
			)}
		</main>
		<Footer />

		<style>
			main { padding-block: var(--s-6) var(--s-4); }
			.blog-header { margin-bottom: var(--s-5); max-width: 62ch; }
			.blog-title { font-size: var(--fs-3xl); font-weight: 800; letter-spacing: var(--tracking-tighter); margin: 0 0 var(--s-2); max-width: 20ch; }
			.blog-subtitle { font-size: var(--fs-lg); color: var(--text-muted); line-height: var(--lh-normal); margin: 0; }
			.no-posts { color: var(--text-muted); font-size: var(--fs-lg); line-height: var(--lh-normal); max-width: 60ch; padding: var(--space-6) 0; border-top: 1px solid var(--border); margin-top: var(--space-5); }

			.filters { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: var(--s-2); }
			.filter {
				font: inherit; font-size: var(--fs-sm); font-weight: 500;
				padding: .4rem .85rem; border-radius: 999px; cursor: pointer;
				border: 1px solid var(--border); background: transparent; color: var(--text-muted);
				transition: color .15s ease, background .15s ease, border-color .15s ease;
			}
			.filter:hover { color: var(--text); border-color: var(--border-strong); }
			.filter.active { color: var(--brand-contrast); background: var(--brand); border-color: var(--brand); }

			.post-list { border-bottom: 1px solid var(--border); }
			.empty { color: var(--text-muted); text-align: center; padding: var(--s-6) 0; }
		</style>

		<script>
			const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
			const rows = document.querySelectorAll<HTMLElement>('#post-list > [data-category]');
			const empty = document.getElementById('empty-state');
			filters.forEach((btn) => {
				btn.addEventListener('click', () => {
					const cat = btn.getAttribute('data-cat');
					filters.forEach((b) => {
						const on = b === btn;
						b.classList.toggle('active', on);
						b.setAttribute('aria-selected', String(on));
					});
					let shown = 0;
					rows.forEach((row) => {
						const match = cat === 'all' || row.getAttribute('data-category') === cat;
						row.hidden = !match;
						if (match) shown++;
					});
					if (empty) empty.hidden = shown !== 0;
				});
			});
		</script>
	</body>
</html>
