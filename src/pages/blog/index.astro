---
import Page from '../../layouts/Page.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import PostListItem from '../../components/PostListItem.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WorkPanel from '../../components/WorkPanel.astro';
import Newsletter from '../../components/Newsletter.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

---

<Page title={`Writing on Rails Reliability & Background Jobs — ${SITE_TITLE}`} description="Production-grounded writing on Rails architecture, background processing, database reliability, and AI-powered backends." mainClass="container">
	<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Writing' }]} />
	<PageHeader class="blog-header" title="Writing">
		<p class="page-lede">Deep dives on Rails reliability: background jobs, Postgres concurrency and AI-powered backends, each grounded in systems I build and ship.</p>
	</PageHeader>

	{posts.length === 0 ? (
		<p class="no-posts">Articles are on the way: deep dives on backend architecture, async pipelines, and AI systems. Check back soon.</p>
	) : (
		<div class="index-grid">
			<section class="post-list" aria-label="All articles">
				{posts.map((post) => <PostListItem post={post} level={2} />)}
			</section>
			<div class="rail">
				<div class="rail-sticky">
					<WorkPanel />
					<Newsletter variant="panel" />
				</div>
			</div>
		</div>
	)}
</Page>

<style>
	main { padding-block: var(--space-10) var(--space-16); }
	.blog-header { margin-bottom: var(--space-8); }
	.no-posts { color: var(--text-muted); font-size: var(--fs-lg); line-height: var(--lh-normal); max-width: 60ch; padding: var(--space-8) 0; border-top: 1px solid var(--border); margin-top: var(--space-6); }

	.index-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-12); }
	@media (min-width: 1000px) { .index-grid { grid-template-columns: minmax(0, 1fr) var(--rail); gap: var(--space-16); } }
	.post-list { min-width: 0; border-bottom: 1px solid var(--border); }
	.rail { min-width: 0; padding-top: var(--space-8); }
	.rail-sticky { display: flex; flex-direction: column; gap: var(--space-8); }
	@media (min-width: 1000px) { .rail-sticky { position: sticky; top: calc(var(--header-h) + var(--space-6)); } }
</style>
