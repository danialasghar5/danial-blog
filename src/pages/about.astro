---
import Page from '../layouts/Page.astro';
import Projects from '../components/Projects.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_TITLE, ROLE, SOCIALS, EMAIL, RESUME_URL } from '../consts';

// ── EDIT ME: replace the placeholders below with your real details ──────────
// Quick-glance stack (moved here from the homepage hero). The Skills section
// below is the detailed breakdown; this is the scannable summary.
const stack = ['Ruby on Rails', 'PostgreSQL', 'Background Processing', 'Distributed Systems', 'AI Backends'];

const skills = [
	{ group: 'Backend', items: ['Ruby on Rails', 'Ruby', 'PostgreSQL', 'REST & GraphQL APIs', 'Service design'] },
	{ group: 'Async & Distributed', items: ['Sidekiq', 'Solid Queue', 'Redis', 'Background jobs', 'Idempotency & retries'] },
	{ group: 'AI Integration', items: ['OpenAI API', 'OpenRouter', 'Structured Outputs', 'Async LLM pipelines'] },
	{ group: 'Platform & Infra', items: ['AWS', 'Docker', 'Cloudflare', 'CI/CD', 'Shopify APIs'] },
];

// NOTE: company names, dates, and specifics below are placeholders — replace with
// real employment history. Kept metric-free (no invented production numbers).
const experience = [
	{
		role: 'Senior Backend Engineer',
		company: 'Freelance / Contract',
		period: '2022 — Present',
		points: [
			'Design and ship production Rails backends for founders and funded startups — API design, background-processing pipelines, and AI integrations.',
			'Move slow or failure-prone work (webhooks, LLM calls, third-party syncs) off the request path into idempotent background jobs.',
		],
	},
	{
		role: 'Backend Engineer',
		company: 'SaaS Product Company',
		period: '2020 — 2022',
		points: [
			'Built multi-tenant billing, teams, and the shared API layer on a Rails SaaS platform.',
			'Owned data modeling and the background-processing behind web and mobile clients.',
		],
	},
	{
		role: 'Backend Engineer',
		company: 'Early-Stage Startup',
		period: '2018 — 2020',
		points: [
			'Designed PostgreSQL data models and background pipelines running on AWS.',
			'Set up automated CI/CD and repeatable deployments for the team.',
		],
	},
];
// ────────────────────────────────────────────────────────────────────────────
---

<Page title={`About — ${SITE_TITLE}`} description={`${SITE_TITLE} — ${ROLE}. Building and scaling production Rails, Shopify, and AWS applications.`} mainClass="container">
	<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
	<!-- Intro -->
	<section class="intro">
		<div class="intro-text">
			<p class="eyebrow">About</p>
			<h1>Backend engineer building reliable Rails systems, high-volume APIs, and AI-powered products.</h1>
			<p class="lede">
				I'm {SITE_TITLE}, a {ROLE.toLowerCase()} focused on Ruby on Rails, PostgreSQL,
				background processing, high-volume APIs, and AI-powered workflows. I partner with
				founders to take production SaaS systems from first commit to scale.
			</p>
			<p class="bio">
				Most of my work lives where a system has to stay correct under failure — a job that
				runs at least once, a webhook delivered twice, an LLM call that is slow, metered, and
				non-deterministic. What I care about is the boundary between "it works on my machine"
				and "it holds under load," and I write about the decisions on that boundary in the <a href="/blog/">blog</a> and by <a href="/topics/">topic</a>. The writing is backed by
				open-source systems I build and ship, so the ideas come with the code that runs them.
				When a team is fighting one of these problems in production, I help directly through <a href="/services/">focused audits and tuning engagements</a>.
			</p>

			<p class="stack"><span class="stack-label">Working with</span> {stack.join(' · ')}</p>

			<nav class="intro-cta" aria-label="Links">
				<a class="cta-primary" href="/services/">Work with me <span aria-hidden="true">&rarr;</span></a>
				{RESUME_URL && <a href={RESUME_URL} target="_blank" rel="noopener">Download résumé</a>}
				<a href={SOCIALS.github} target="_blank" rel="noopener">GitHub</a>
				<a href={SOCIALS.twitter} target="_blank" rel="noopener">X</a>
			</nav>
		</div>
		<aside class="intro-facts">
			<dl>
				<div><dt>Role</dt><dd>{ROLE}</dd></div>
				<div><dt>Focus</dt><dd>Rails · PostgreSQL · Async · AI backends</dd></div>
				<div><dt>Availability</dt><dd>Open to freelance & contract</dd></div>
				<div><dt>Email</dt><dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd></div>
			</dl>
		</aside>
	</section>

	<!-- Skills -->
	<section class="block">
		<div class="section-head"><h2>Skills</h2></div>
		<div class="skills-grid">
			{skills.map((s) => (
				<div class="skill-cat">
					<h3>{s.group}</h3>
					<p>{s.items.join(' · ')}</p>
				</div>
			))}
		</div>
	</section>

	<!-- Experience timeline -->
	<section class="block">
		<div class="section-head"><h2>Experience</h2></div>
		<ol class="timeline">
			{experience.map((e) => (
				<li class="tl-item">
					<span class="tl-period">{e.period}</span>
					<div class="tl-body">
						<h3>{e.role}</h3>
						<p class="tl-company">{e.company}</p>
						<ul class="tl-points">{e.points.map((p) => <li>{p}</li>)}</ul>
					</div>
				</li>
			))}
		</ol>
	</section>
	<Fragment slot="after-main">
		<!-- Featured work -->
		<Projects />
	</Fragment>
</Page>

<style>
	main { padding-block: var(--space-16) var(--space-8); }

	.intro {
		display: grid; grid-template-columns: 1fr; gap: var(--space-12);
		padding-bottom: var(--space-12); border-bottom: 1px solid var(--border);
	}
	@media (min-width: 900px) { .intro { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); align-items: start; } }
	.intro h1 { font-size: var(--fs-3xl); font-weight: 700; letter-spacing: var(--tracking-tighter); margin: 0 0 var(--space-6); max-width: 20ch; }
	.lede { font-family: var(--font-prose); font-size: var(--fs-xl); color: var(--text-muted); line-height: var(--lh-normal); margin: 0 0 var(--space-6); max-width: var(--measure); }
	.bio { font-family: var(--font-prose); font-size: var(--fs-lg); color: var(--text); line-height: var(--lh-prose); margin: 0 0 var(--space-8); max-width: var(--measure); }
	.bio a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--border-strong); }
	.bio a:hover { color: var(--brand); text-decoration-color: var(--brand); }

	.stack { margin: 0 0 var(--space-8); font-size: var(--fs-sm); color: var(--text-muted); }
	.stack-label { color: var(--text-faint); margin-right: .35rem; }

	.intro-cta { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-8); }
	.intro-cta a { font-size: var(--fs-sm); font-weight: 500; color: var(--text-muted); text-decoration: none; }
	.intro-cta a:hover { color: var(--text); }
	.intro-cta .cta-primary { font-size: var(--fs-base); font-weight: 600; color: var(--brand); }
	.intro-cta .cta-primary:hover { color: var(--brand-hover); }

	/* Facts: definition rows between hairlines, no box. */
	.intro-facts dl { margin: 0; border-top: 1px solid var(--border); }
	.intro-facts div { display: flex; flex-direction: column; gap: .15rem; padding: var(--space-4) 0; border-bottom: 1px solid var(--border); }
	.intro-facts dt { font-size: var(--fs-xs); color: var(--text-faint); }
	.intro-facts dd { margin: 0; font-size: var(--fs-sm); font-weight: 500; }

	.block { padding-block: var(--space-12); }

	.skills-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-8) var(--space-12); }
	@media (min-width: 640px) { .skills-grid { grid-template-columns: repeat(2, 1fr); } }
	.skill-cat h3 { font-size: var(--fs-sm); font-weight: 600; margin: 0 0 var(--space-2); }
	.skill-cat p { margin: 0; font-size: var(--fs-base); color: var(--text-muted); line-height: var(--lh-normal); }

	/* Experience: hairline rows, the period in a faint left column. */
	.timeline { list-style: none; margin: 0; padding: 0; }
	.tl-item {
		display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: var(--space-1) var(--space-6);
		align-items: baseline; padding: var(--space-6) 0; border-top: 1px solid var(--border);
	}
	.tl-item:first-child { border-top: 0; }
	.tl-period { font-size: var(--fs-sm); color: var(--text-faint); white-space: nowrap; font-variant-numeric: tabular-nums; }
	.tl-body h3 { font-size: var(--fs-lg); font-weight: 600; margin: 0; }
	.tl-company { color: var(--text-muted); font-size: var(--fs-sm); margin: .15rem 0 var(--space-3); }
	.tl-points { margin: 0; padding-left: 1.1rem; color: var(--text-muted); font-size: var(--fs-base); line-height: var(--lh-normal); }
	.tl-points li { margin-bottom: .35rem; }
	.tl-points li::marker { color: var(--text-faint); }
	@media (max-width: 640px) { .tl-item { grid-template-columns: 1fr; } }
</style>
