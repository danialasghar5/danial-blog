---
import Page from '../layouts/Page.astro';
import PageHeader from '../components/PageHeader.astro';
import Projects from '../components/Projects.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_TITLE } from '../consts';
---

<Page title={`Projects — ${SITE_TITLE}`} description="Applications, tools, and SaaS extensions I've designed, built, and shipped with Rails, Shopify, and AWS." mainClass="container">
	<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Projects' }]} />
	<PageHeader class="projects-header" eyebrow="Portfolio" title="Things I've built">
		<p class="page-lede projects-subtitle">A selection of applications, tools, and SaaS extensions I've designed, built, and shipped to production.</p>
	</PageHeader>
	<Projects showAll={true} withHeader={false} />
</Page>

<style>
	main { padding-block: var(--space-12) 0; }
	.projects-header { padding-bottom: var(--space-8); border-bottom: 1px solid var(--border); }
	.projects-header :global(.page-title) { margin-bottom: var(--space-2); }
	.projects-subtitle { max-width: 62ch; }
</style>
