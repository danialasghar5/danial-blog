---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Projects from '../components/Projects.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects — ${SITE_TITLE}`} description="Applications, tools, and SaaS extensions I've designed, built, and shipped with Rails, Shopify, and AWS." />
	</head>
	<body>
		<Header />
		<main id="main-content" class="container">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Projects' }]} />
			<div class="projects-header">
				<p class="eyebrow">Portfolio</p>
				<h1 class="projects-title">Things I've built</h1>
				<p class="projects-subtitle">A selection of applications, tools, and SaaS extensions I've designed, built, and shipped to production.</p>
			</div>
			<Projects showAll={true} withHeader={false} />
		</main>
		<Footer />

		<style>
			main { padding-block: var(--s-6) 0; }
			.projects-header { padding-bottom: var(--s-4); border-bottom: 1px solid var(--border); }
			.projects-title { font-size: var(--fs-3xl); font-weight: 800; letter-spacing: var(--tracking-tighter); margin: 0 0 var(--s-1); }
			.projects-subtitle { font-size: var(--fs-lg); color: var(--text-muted); line-height: var(--lh-normal); margin: 0; max-width: 62ch; }
		</style>
	</body>
</html>
