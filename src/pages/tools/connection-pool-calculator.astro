---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { NAME } from '../../consts';

const TITLE = 'Sidekiq & Puma Connection Pool Calculator';

// Default inputs. Pool 5 vs Sidekiq concurrency 10 deliberately opens on a
// "Risk" verdict — the single most common real misconfig. Set db_pool to 12 to
// open green instead.
const fields = [
	{ id: 'puma_workers', label: 'Puma workers (processes)', value: 2 },
	{ id: 'puma_threads', label: 'Puma threads per worker', value: 5 },
	{ id: 'sidekiq_processes', label: 'Sidekiq processes', value: 1 },
	{ id: 'sidekiq_concurrency', label: 'Sidekiq concurrency (threads)', value: 10 },
	{ id: 'db_pool', label: 'DB pool size (database.yml)', value: 5 },
	{ id: 'db_max', label: 'Postgres max_connections', value: 100 },
];

// Rendered on the page AND emitted as FAQPage schema, so the two never drift.
const faqs = [
	{
		q: 'How many connections does Sidekiq need?',
		a: 'One per running worker thread. If Sidekiq concurrency is 10, its process needs a pool of at least 10 (plus a little headroom) so no job stalls waiting to check out a connection.',
	},
	{
		q: 'Should Puma and Sidekiq share the same pool size?',
		a: "They don't have to. They're separate processes with separate pools, so size each to its own thread count — Puma threads for the web pool, Sidekiq concurrency for the worker pool. One database.yml can serve both if the pool is read from an environment variable you set per process.",
	},
	{
		q: 'What causes ActiveRecord::ConnectionTimeoutError?',
		a: 'A thread asked the pool for a connection and none was free within the timeout. Almost always it means the pool is smaller than the number of threads contending for it — a configuration issue, not a database fault.',
	},
];

const site = Astro.site?.toString() ?? 'https://danialasghar.com/';
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqs.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a },
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: TITLE,
		url: new URL('/tools/connection-pool-calculator/', site).toString(),
		applicationCategory: 'DeveloperApplication',
		operatingSystem: 'Web',
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		author: { '@id': `${site}#person` },
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Sidekiq Connection Pool Calculator — Fix Pool Exhaustion | ${NAME}`}
			description="Free calculator: size your Rails database pool against Puma threads and Sidekiq concurrency. Avoid ActiveRecord::ConnectionTimeoutError and Postgres connection exhaustion."
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
	</head>
	<body>
		<Header />
		<main id="main-content" class="container">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools' }, { label: 'Connection Pool Calculator' }]} />

			<header class="tool-header">
				<p class="eyebrow">Developer Tools</p>
				<h1>{TITLE}</h1>
				<p class="lede">
					Size your Rails database pool against Puma threads and Sidekiq concurrency — and see
					before you deploy whether you'll hit <code>ActiveRecord::ConnectionTimeoutError</code>
					or exhaust Postgres connections. Runs entirely in your browser.
				</p>
			</header>

			<section class="calc" aria-label="Calculator">
				<div class="fields">
					{fields.map((f) => (
						<label class="field">
							<span>{f.label}</span>
							<input type="number" inputmode="numeric" min="1" step="1" id={f.id} value={f.value} />
						</label>
					))}
				</div>

				<div id="verdict" class="verdict" role="status" aria-live="polite"></div>

				<div class="snippet">
					<div class="snippet-head">
						<span>Recommended config/database.yml</span>
						<button id="copy-btn" class="btn btn-secondary btn-sm" type="button">Copy</button>
					</div>
					<pre id="snippet"></pre>
				</div>
			</section>

			<nav class="funnel" aria-label="Related">
				<a href="/blog/why-background-jobs-are-slow/">Why this happens &rarr;</a>
				<a href="/services">Struggling with this in production? &rarr;</a>
			</nav>

			<!-- Below-the-fold content: answers the search intent this page targets. -->
			<article class="content">
				<h2>How to size your Sidekiq connection pool</h2>
				<p>
					Every thread that runs a database query needs its own connection from the Rails pool.
					In a Rails app that means two separate pools to reason about: your web process (Puma)
					and your worker process (Sidekiq). The pool size is set per process in
					<code>config/database.yml</code>, and the single most common production error —
					<em>could not obtain a connection from the pool</em> — happens when a process runs
					more threads than its pool has connections.
				</p>

				<h2>The rule: pool size must cover your threads</h2>
				<p>
					For the web process, your pool must be at least your Puma thread count. For the worker
					process, your pool must be at least your Sidekiq concurrency. On Solid Queue the same
					idea applies, with the guidance to keep worker threads at or below your pool size minus
					two — two connections are reserved for the queue's own polling and heartbeat. A good
					default is to set the pool to your thread count plus a small amount of headroom.
				</p>
				<p>
					A common trap: the default Rails <code>database.yml</code> sizes the pool from
					<code>RAILS_MAX_THREADS</code>. If that variable is set to your Puma thread count and
					your Sidekiq process inherits it, the worker gets a web-sized pool. Size the pool from a
					variable you set per process — or give it a default large enough for the biggest one.
				</p>

				<h2>Don't exceed Postgres max_connections</h2>
				<p>
					The second failure mode is global: the sum of all connections across every Puma worker
					and every Sidekiq process can exceed Postgres's <code>max_connections</code> ceiling
					(minus the few slots Postgres reserves for superusers — three by default). When that
					happens, new connection attempts are refused database-wide. If your peak total
					approaches that ceiling, the usual fix is a connection pooler like PgBouncer in front of
					Postgres, or lowering per-process concurrency.
				</p>

				<h2>Frequently asked questions</h2>
				{faqs.map((f) => (
					<>
						<h3>{f.q}</h3>
						<p>{f.a}</p>
					</>
				))}
			</article>
		</main>
		<Footer />

		<style>
			main { padding-block: var(--s-8) var(--s-4); max-width: var(--container-prose); }

			.tool-header h1 { font-size: var(--fs-3xl); font-weight: 800; letter-spacing: var(--tracking-tighter); line-height: var(--lh-tight); margin: 0 0 var(--s-2); }
			.lede { font-size: var(--fs-lg); color: var(--text-muted); line-height: var(--lh-normal); margin: 0 0 var(--s-5); max-width: 66ch; }

			.calc {
				padding: var(--s-3);
				background: var(--card-bg);
				border: 1px solid var(--border); border-radius: var(--radius-lg);
			}
			.fields { display: grid; gap: var(--s-2) var(--s-3); grid-template-columns: 1fr; }
			@media (min-width: 620px) { .fields { grid-template-columns: 1fr 1fr; } }
			.field { display: flex; flex-direction: column; gap: .35rem; }
			.field span { font-size: var(--fs-sm); color: var(--text-muted); }
			.field input {
				font-family: var(--font-mono); font-size: var(--fs-base); color: var(--text);
				padding: 9px 12px;
				background: var(--bg);
				border: 1px solid var(--border-strong); border-radius: var(--radius);
				transition: border-color .15s ease, box-shadow .15s ease;
			}
			.field input:focus-visible { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-ring); }

			.verdict {
				margin-top: var(--s-3); padding: var(--s-2);
				border: 1px solid var(--border); border-radius: var(--radius);
				font-size: var(--fs-sm); line-height: var(--lh-normal);
			}
			.verdict.is-ok { border-color: var(--brand-ring); background: var(--brand-soft); color: var(--text); }
			.verdict.is-risk { border-color: color-mix(in srgb, var(--dg-hazard) 45%, transparent); background: var(--dg-hazard-fill); color: var(--text); }
			.verdict :global(strong) { font-weight: 700; }
			.verdict.is-ok :global(strong) { color: var(--brand); }
			.verdict.is-risk :global(strong) { color: var(--dg-hazard); }
			.verdict :global(ul) { margin: .4rem 0 0; padding-left: 1.2rem; }
			.verdict :global(li) { margin-bottom: .25rem; }
			.verdict :global(.note) { margin: .4rem 0 0; color: var(--text-muted); }

			.snippet { margin-top: var(--s-2); }
			.snippet-head {
				display: flex; align-items: center; justify-content: space-between; gap: var(--s-2);
				margin-bottom: .5rem;
				font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--text-faint); font-weight: 600;
			}
			.snippet pre { margin: 0; font-size: var(--fs-xs); white-space: pre; overflow-x: auto; }

			.funnel { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-3); margin-top: var(--s-3); font-size: var(--fs-sm); font-weight: 600; }

			.content {
				margin-top: var(--s-8); padding-top: var(--s-4);
				border-top: 1px solid var(--border);
				font-family: var(--font-prose); font-size: var(--fs-lg); line-height: var(--lh-prose);
			}
			.content h2 { font-family: var(--font-sans); font-size: var(--fs-2xl); font-weight: 700; letter-spacing: var(--tracking-tight); margin: var(--s-5) 0 var(--s-2); }
			.content h2:first-child { margin-top: 0; }
			.content h3 { font-family: var(--font-sans); font-size: var(--fs-xl); font-weight: 700; margin: var(--s-4) 0 var(--s-1); }
			.content p { margin: 0 0 var(--s-3); }
		</style>

		<script>
			// 100% client-side — no network calls. Two failure modes:
			//   1. per process: pool < threads in that process → ConnectionTimeoutError
			//   2. global: peak connections across all processes > usable Postgres slots
			const RESERVED = 3; // Postgres superuser_reserved_connections default
			const HEADROOM = 2;
			const ids = ['puma_workers', 'puma_threads', 'sidekiq_processes', 'sidekiq_concurrency', 'db_pool', 'db_max'] as const;
			type Id = (typeof ids)[number];

			const inputs = Object.fromEntries(
				ids.map((id) => [id, document.getElementById(id) as HTMLInputElement])
			) as Record<Id, HTMLInputElement>;
			const verdict = document.getElementById('verdict')!;
			const snippet = document.getElementById('snippet')!;
			const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;

			const val = (id: Id) => {
				const n = parseInt(inputs[id].value, 10);
				return Number.isFinite(n) && n >= 1 ? n : 1;
			};

			function compute() {
				const pumaW = val('puma_workers'), pumaT = val('puma_threads');
				const skP = val('sidekiq_processes'), skC = val('sidekiq_concurrency');
				const pool = val('db_pool'), dbMax = val('db_max');

				const webPool = pumaT + HEADROOM;
				const workerPool = skC + HEADROOM;
				const recommendedPool = Math.max(webPool, workerPool);
				// Worst case: every thread in every process holds a connection.
				const totalPeak = pumaW * pumaT + skP * skC;
				const usable = Math.max(dbMax - RESERVED, 0);

				const problems: string[] = [];
				if (pool < pumaT)
					problems.push(`Web pool (${pool}) is smaller than Puma threads (${pumaT}) — web requests will hit ConnectionTimeoutError.`);
				if (pool < skC)
					problems.push(`Worker pool (${pool}) is smaller than Sidekiq concurrency (${skC}) — jobs will stall waiting for a connection.`);
				if (totalPeak > usable)
					problems.push(`Peak connections (${totalPeak}) exceed the ${usable} usable Postgres connections (max_connections ${dbMax} − ${RESERVED} reserved) — add PgBouncer or lower concurrency.`);

				verdict.replaceChildren();
				if (problems.length === 0) {
					verdict.className = 'verdict is-ok';
					const p = document.createElement('p');
					p.style.margin = '0';
					p.innerHTML = `<strong>✓ Safe.</strong> `;
					p.append(`Pool covers your threads, and peak connections (${totalPeak}) stay within the ${usable} usable Postgres connections.`);
					verdict.append(p);
					if (totalPeak > usable * 0.8) {
						const note = document.createElement('p');
						note.className = 'note';
						note.textContent = `Close to the ceiling (${Math.round((totalPeak / usable) * 100)}%). Consoles, migrations, and deploy overlap (old + new processes) also need connections.`;
						verdict.append(note);
					}
				} else {
					verdict.className = 'verdict is-risk';
					const head = document.createElement('strong');
					head.textContent = '✗ Risk';
					const ul = document.createElement('ul');
					for (const msg of problems) {
						const li = document.createElement('li');
						li.textContent = msg;
						ul.append(li);
					}
					verdict.append(head, ul);
				}

				const web = `web (Puma, ${pumaT} threads)`;
				const worker = `worker (Sidekiq, concurrency ${skC})`;
				const w = Math.max(web.length, worker.length);
				snippet.textContent = [
					'production:',
					'  adapter: postgresql',
					'  # One pool per process: size it to the threads in THAT process + 2.',
					`  #   ${web.padEnd(w)} → DB_POOL=${webPool}`,
					`  #   ${worker.padEnd(w)} → DB_POOL=${workerPool}`,
					'  # Use a dedicated var, not RAILS_MAX_THREADS, so Sidekiq never inherits a web-sized pool.',
					`  pool: <%= ENV.fetch("DB_POOL", ${recommendedPool}) %>`,
					`  # Peak across all processes: ${totalPeak} of ${usable} usable Postgres connections`,
				].join('\n');
			}

			ids.forEach((id) => inputs[id].addEventListener('input', compute));

			copyBtn.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(snippet.textContent ?? '');
					copyBtn.textContent = 'Copied';
				} catch {
					copyBtn.textContent = 'Copy failed';
				}
				setTimeout(() => (copyBtn.textContent = 'Copy'), 1500);
			});

			compute();
		</script>
	</body>
</html>
