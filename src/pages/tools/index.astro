---
import Page from '../../layouts/Page.astro';
import PageHeader from '../../components/PageHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { NAME } from '../../consts';

// Add future tools here (each one is its own page under /tools/).
const tools = [
	{
		href: '/tools/connection-pool-calculator/',
		title: 'Sidekiq & Puma Connection Pool Calculator',
		blurb: 'Size your Rails database pool against Puma threads and Sidekiq concurrency, and check total connections against Postgres max_connections.',
	},
];
---

<Page title={`Developer Tools — Rails & Background Jobs | ${NAME}`}
	description="Free, client-side developer tools for Rails reliability: connection-pool sizing for Puma, Sidekiq, and Postgres." mainClass="container">
	<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools' }]} />
	<PageHeader eyebrow="Developer Tools" title="Tools for Rails reliability">
		<p class="page-lede lede">Small, free calculators for the production problems I write about. Everything runs in your browser — nothing you enter leaves the page.</p>
	</PageHeader>

	<ul class="tools">
		{tools.map((t) => (
			<li>
				<a class="tool" href={t.href}>
					<h2>{t.title}</h2>
					<p>{t.blurb}</p>
					<span class="go">Open tool &rarr;</span>
				</a>
			</li>
		))}
	</ul>
</Page>

<style>
	main { padding-block: var(--space-16) var(--space-8); }
	.lede { margin: 0 0 var(--space-10); max-width: 62ch; }
	/* Tool rows: name and summary on the left, the action on the right. */
	.tools { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--border); }
	.tools li { border-top: 1px solid var(--border); }
	.tool {
		display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2) var(--space-8);
		align-items: baseline; padding: var(--space-6) 0;
		color: var(--text); text-decoration: none;
	}
	.tool h2 { grid-column: 1; font-size: var(--fs-xl); font-weight: 600; line-height: var(--lh-snug); margin: 0; transition: color .15s ease; }
	.tool p { grid-column: 1; margin: 0; max-width: 68ch; font-size: var(--fs-base); color: var(--text-muted); line-height: var(--lh-normal); }
	.go { grid-column: 2; grid-row: 1; white-space: nowrap; font-size: var(--fs-sm); font-weight: 600; color: var(--brand); }
	.tool:hover h2 { color: var(--brand); }
	@media (max-width: 560px) {
		.tool { grid-template-columns: 1fr; }
		.go { grid-column: 1; grid-row: auto; }
	}
</style>
