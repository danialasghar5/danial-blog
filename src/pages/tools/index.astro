---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { NAME } from '../../consts';

// Add future tools here (each one is its own page under /tools/).
const tools = [
	{
		href: '/tools/connection-pool-calculator/',
		title: 'Sidekiq & Puma Connection Pool Calculator',
		blurb: 'Size your Rails database pool against Puma threads and Sidekiq concurrency, and check total connections against Postgres max_connections.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Developer Tools — Rails & Background Jobs | ${NAME}`}
			description="Free, client-side developer tools for Rails reliability: connection-pool sizing for Puma, Sidekiq, and Postgres."
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" class="container">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools' }]} />
			<header>
				<p class="eyebrow">Developer Tools</p>
				<h1>Tools for Rails reliability</h1>
				<p class="lede">Small, free calculators for the production problems I write about. Everything runs in your browser — nothing you enter leaves the page.</p>
			</header>

			<ul class="tools">
				{tools.map((t) => (
					<li>
						<a class="card tool" href={t.href}>
							<h2>{t.title}</h2>
							<p>{t.blurb}</p>
							<span class="go">Open tool &rarr;</span>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />

		<style>
			main { padding-block: var(--s-8) var(--s-4); }
			h1 { font-size: var(--fs-3xl); font-weight: 800; letter-spacing: var(--tracking-tighter); margin: 0 0 var(--s-2); }
			.lede { font-size: var(--fs-lg); color: var(--text-muted); line-height: var(--lh-normal); margin: 0 0 var(--s-5); max-width: 62ch; }
			.tools { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); grid-template-columns: 1fr; }
			@media (min-width: 760px) { .tools { grid-template-columns: repeat(2, 1fr); } }
			.tool { display: flex; flex-direction: column; gap: var(--s-1); height: 100%; padding: var(--s-3); color: var(--text); text-decoration: none; }
			.tool h2 { font-size: var(--fs-lg); font-weight: 700; line-height: var(--lh-snug); margin: 0; }
			.tool p { margin: 0; font-size: var(--fs-sm); color: var(--text-muted); line-height: var(--lh-normal); }
			.go { margin-top: auto; padding-top: var(--s-1); font-size: var(--fs-sm); font-weight: 600; color: var(--brand); }
		</style>
	</body>
</html>
