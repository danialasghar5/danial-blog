---
import Page from '../layouts/Page.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_TITLE, EMAIL, SOCIALS } from '../consts';

const channels = [
	{ label: 'Email', value: EMAIL, href: `mailto:${EMAIL}`, note: 'Best for project inquiries' },
	{ label: 'GitHub', value: `@${SOCIALS.githubUser}`, href: SOCIALS.github, note: 'Code & open source' },
	{ label: 'X / Twitter', value: SOCIALS.twitterHandle, href: SOCIALS.twitter, note: 'Quick questions & DMs' },
];
---

<Page title={`Contact — ${SITE_TITLE}`} description={`Get in touch with ${SITE_TITLE} about freelance and contract engineering work.`} mainClass="container">
	<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
	<section class="contact">
		<PageHeader eyebrow="Contact" title="Let's build something.">
			<p class="page-lede lede">
				I'm open to freelance and contract work on Rails, Shopify, and AWS projects.
				Tell me what you're building and I'll get back to you.
			</p>
			<p class="lede-sub">
				Fighting a reliability problem in production? See the fixed-scope <a href="/services">Rails reliability services</a>.
			</p>
		</PageHeader>

		<div class="channels">
			{channels.map((c) => (
				<a class="channel" href={c.href} target={c.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener">
					<div>
						<span class="ch-label">{c.label}</span>
						<span class="ch-value">{c.value}</span>
					</div>
					<span class="ch-note">{c.note}</span>
				</a>
			))}
		</div>

		<a class="btn btn-primary big" href={`mailto:${EMAIL}`}>Email me &rarr;</a>
	</section>
</Page>

<style>
	main { padding-block: var(--space-16) var(--space-12); }
	/* Left-aligned with the breadcrumb, like every other page. */
	.contact { max-width: var(--container-prose); }
	.lede { margin: 0 0 var(--space-4); }
	.lede-sub { color: var(--text-muted); margin: 0 0 var(--space-10); }
	.lede-sub a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--border-strong); }
	.lede-sub a:hover { color: var(--brand); text-decoration-color: var(--brand); }

	/* Channels: hairline rows, no cards. */
	.channels { margin-bottom: var(--space-10); border-bottom: 1px solid var(--border); }
	.channel {
		display: grid; grid-template-columns: 8.5rem minmax(0, 1fr) auto; align-items: baseline; gap: var(--space-6);
		padding: var(--space-5) 0; border-top: 1px solid var(--border);
		color: var(--text); text-decoration: none;
	}
	.channel > div { display: contents; }
	.ch-label { font-size: var(--fs-sm); color: var(--text-faint); }
	.ch-value { font-weight: 600; transition: color .15s ease; }
	.channel:hover .ch-value { color: var(--brand); }
	.ch-note { font-size: var(--fs-sm); color: var(--text-muted); text-align: right; }
	.big { padding: .8rem 1.4rem; font-size: var(--fs-base); }
	@media (max-width: 560px) {
		.channel { grid-template-columns: 1fr; gap: .15rem; }
		.ch-note { display: none; }
	}
</style>
