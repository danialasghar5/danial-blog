---
import Page from '../layouts/Page.astro';
import { SITE_TITLE } from '../consts';
---

<Page title={`Page not found | ${SITE_TITLE}`} description="The page you were looking for doesn't exist." mainClass="container">
	<section class="nf">
		<p class="code">404</p>
		<h1>This page took a different path.</h1>
		<p class="lede">The page you're looking for doesn't exist or has moved.</p>
		<div class="nf-cta">
			<a class="btn btn-primary" href="/">Back home</a>
			<a class="btn btn-ghost" href="/blog/">Read the blog</a>
		</div>
	</section>
</Page>

<style>
	main { display: grid; place-items: center; min-height: 60vh; padding-block: var(--space-16); }
	.nf { text-align: center; max-width: 40ch; }
	.code { font-size: 4rem; font-weight: 800; color: var(--brand); margin: 0; letter-spacing: var(--tracking-tighter); }
	.nf h1 { font-size: var(--fs-2xl); margin: 0 0 var(--space-4); }
	.lede { color: var(--text-muted); margin: 0 0 var(--space-8); }
	.nf-cta { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; }
</style>
