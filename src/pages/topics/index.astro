---
import Page from '../../layouts/Page.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE_TITLE } from '../../consts';
import { liveTopics, topicUrl } from '../../data/topics';

const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
const countFor = (slug: string) => posts.filter((p) => p.data.category === slug).length;

const hubs = liveTopics().map((t) => ({ ...t, count: countFor(t.slug) }));

const description = 'Browse the blog by topic — curated hubs on backend reliability engineering.';
const site = Astro.site?.toString() ?? 'https://danialasghar.com/';
const canonical = new URL('/topics/', site).toString();

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'CollectionPage',
			'@id': canonical,
			url: canonical,
			name: 'Topics',
			description,
			isPartOf: { '@id': `${site}#website` },
			mainEntity: {
				'@type': 'ItemList',
				itemListElement: hubs.map((h, i) => ({
					'@type': 'ListItem',
					position: i + 1,
					url: new URL(topicUrl(h.slug), site).toString(),
					name: h.title,
				})),
			},
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: site },
				{ '@type': 'ListItem', position: 2, name: 'Topics', item: canonical },
			],
		},
	],
};
---

<Page title={`Topics — ${SITE_TITLE}`} description={description} mainClass="container">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
	</Fragment>
	<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Topics' }]} schema={false} />

	<PageHeader class="topics-header" eyebrow="Browse" title="Topics">
		<p class="page-lede topics-subtitle">How this blog is organized — each hub is a focused body of work on one part of backend reliability engineering.</p>
	</PageHeader>

	<ul class="hub-list">
		{hubs.map((hub) => (
			<li>
				<a class="hub-block" href={topicUrl(hub.slug)}>
					<div class="hub-copy">
						<h2>{hub.title}</h2>
						<p class="hub-blurb">{hub.blurb}</p>
					</div>
					<span class="hub-meta">
						{hub.count} {hub.count === 1 ? 'article' : 'articles'}
						<span class="arrow" aria-hidden="true">→</span>
					</span>
				</a>
			</li>
		))}
	</ul>
</Page>

<style>
	main { padding-block: var(--space-12) var(--space-8); }
	.topics-header { margin-bottom: var(--space-10); }
	.topics-header :global(.eyebrow) { font-size: var(--fs-sm); font-weight: 600; }
	.topics-header :global(.page-title) { margin-bottom: var(--space-2); }
	.topics-subtitle { max-width: 62ch; }

	/* Hub rows: hairline-separated, like the writing index. */
	.hub-list { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--border); }
	.hub-list li { border-top: 1px solid var(--border); }
	.hub-block {
		display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-6);
		padding: var(--space-6) 0; color: var(--text); text-decoration: none;
	}
	.hub-copy h2 { margin: 0 0 .25rem; font-size: var(--fs-xl); font-weight: 600; line-height: var(--lh-snug); transition: color .15s ease; }
	.hub-block:hover .hub-copy h2 { color: var(--brand); }
	.hub-blurb { margin: 0; color: var(--text-muted); font-size: var(--fs-base); line-height: var(--lh-normal); max-width: 60ch; }
	.hub-meta {
		display: inline-flex; align-items: center; gap: .4rem; white-space: nowrap;
		font-size: var(--fs-sm); color: var(--text-faint);
	}
	.arrow { transition: transform .15s ease, color .15s ease; }
	.hub-block:hover .arrow { color: var(--brand); transform: translateX(3px); }

	@media (max-width: 560px) {
		.hub-block { flex-direction: column; gap: var(--space-2); }
	}
</style>
