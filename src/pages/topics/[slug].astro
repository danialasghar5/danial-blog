---
import Page from '../../layouts/Page.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PostListItem from '../../components/PostListItem.astro';
import TopicChip from '../../components/TopicChip.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { readingTime } from '../../utils/reading-time';
import { SITE_TITLE } from '../../consts';
import { liveTopics, getTopic, topicUrl } from '../../data/topics';

// Rollout gate: only live hubs get a page.
export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
	return liveTopics().map((topic) => ({
		params: { slug: topic.slug },
		props: {
			topic,
			posts: posts
				.filter((p) => p.data.category === topic.slug)
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { topic, posts } = Astro.props;

const startHerePost = topic.startHere
	? posts.find((p) => p.id === topic.startHere)
	: undefined;

// Cross-link only to sibling hubs that are actually published.
const relatedLive = topic.related.map((s) => getTopic(s)).filter((t) => t?.live);

const site = Astro.site?.toString() ?? 'https://danialasghar.com/';
const canonical = new URL(topicUrl(topic.slug), site).toString();

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'CollectionPage',
			'@id': canonical,
			url: canonical,
			name: topic.title,
			description: topic.blurb,
			keywords: topic.keywords.join(', '),
			isPartOf: { '@id': `${site}#website` },
			mainEntity: {
				'@type': 'ItemList',
				itemListElement: posts.map((p, i) => ({
					'@type': 'ListItem',
					position: i + 1,
					url: new URL(`/blog/${p.id}/`, site).toString(),
					name: p.data.title,
				})),
			},
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: site },
				{ '@type': 'ListItem', position: 2, name: 'Topics', item: new URL('/topics/', site).toString() },
				{ '@type': 'ListItem', position: 3, name: topic.title, item: canonical },
			],
		},
	],
};
---

<Page title={`${topic.title} — ${SITE_TITLE}`} description={topic.blurb} mainClass="container">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
	</Fragment>
	<Breadcrumbs items={[
		{ label: 'Home', href: '/' },
		{ label: 'Topics', href: '/topics/' },
		{ label: topic.title },
	]} schema={false} />

	<PageHeader class="hub-header" eyebrow="Topic" title={topic.title}>
		<div class="hub-intro">
			{topic.intro.map((para) => <p set:html={para} />)}
		</div>
	</PageHeader>

	{startHerePost && (
		<section class="start-here" aria-label="Start here">
			<p class="section-eyebrow">Start here</p>
			<a class="start-card" href={`/blog/${startHerePost.id}/`}>
				<h2>{startHerePost.data.title}</h2>
				<p class="start-desc">{startHerePost.data.description}</p>
				<div class="start-meta">
					<FormattedDate date={startHerePost.data.pubDate} />
					<span class="dot">·</span>
					<span>{readingTime(startHerePost.body)}</span>
				</div>
			</a>
		</section>
	)}

	{posts.length > 0 && (
		<section class="hub-list" aria-label="More articles">
			<p class="section-eyebrow">More articles</p>
			<div class="post-list">
				{posts.filter((p) => p.id !== topic.startHere).map((post) => <PostListItem post={post} />)}
			</div>
		</section>
	)}

	{relatedLive.length > 0 && (
		<section class="related" aria-label="Related topics">
			<p class="section-eyebrow">Related topics</p>
			<div class="related-chips">
				{relatedLive.map((t) => <TopicChip slug={t!.slug} arrow />)}
			</div>
		</section>
	)}
</Page>

<style>
	main { padding-block: var(--space-12) var(--space-8); }

	.hub-header { margin-bottom: var(--space-12); }
	.hub-header :global(.eyebrow) { font-size: var(--fs-sm); font-weight: 600; }
	.hub-header :global(.page-title) { margin-bottom: var(--space-6); max-width: 24ch; }
	.hub-intro {
		font-family: var(--font-prose);
		font-size: var(--fs-lg); line-height: var(--lh-prose); color: var(--text);
		max-width: 68ch;
	}
	.hub-intro :global(p) { margin: 0 0 var(--space-6); }
	.hub-intro :global(p:last-child) { margin-bottom: 0; }

	/* Section label; the list below supplies the hairline. */
	.section-eyebrow { font-size: var(--fs-sm); font-weight: 600; color: var(--text); margin: 0 0 var(--space-3); }

	.start-here { margin-bottom: var(--space-12); }
	/* The cornerstone post: a larger row between hairlines, no box. */
	.start-card {
		display: block; text-decoration: none; color: var(--text);
		padding: var(--space-6) 0;
		border-block: 1px solid var(--border);
	}
	.start-card h2 { margin: 0 0 var(--space-2); font-size: var(--fs-2xl); font-weight: 600; line-height: var(--lh-snug); letter-spacing: var(--tracking-tight); transition: color .15s ease; }
	.start-card:hover h2 { color: var(--brand); }
	.start-desc { margin: 0 0 var(--space-3); font-family: var(--font-prose); color: var(--text-muted); font-size: var(--fs-lg); line-height: var(--lh-normal); max-width: 68ch; }
	.start-meta { display: flex; align-items: center; gap: .4rem; font-size: var(--fs-sm); color: var(--text-faint); }
	.dot { color: var(--text-faint); }

	.hub-list { margin-bottom: var(--space-12); }
	.hub-list .post-list { border-bottom: 1px solid var(--border); }

	.related-chips { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); }
</style>
