{
  "name": "danial-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "icons": "node scripts/generate-icons.mjs",
    "seo:baseline": "astro build && node scripts/seo-regression.mjs --baseline",
    "seo:check": "astro build && node scripts/seo-regression.mjs",
    "security:check": "astro build && node scripts/security-check.mjs",
    "security:live": "node scripts/security-check.mjs --live https://danialasghar.com",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.4.13",
    "rehype-autolink-headings": "7.1.0",
    "sharp": "0.35.5"
  }
}
