<%# app/views/pages/services.html.erb %>
<%#
  Dark, editorial, conversion-focused. Assumes a dark layout with Tailwind.
  Replace $X,XXX placeholders and the Cal.com URL before shipping.
%>

<main class="mx-auto max-w-3xl px-5 py-16 sm:py-24">

  <!-- Hero: the client's problem, not a job title -->
  <section class="text-center">
    <p class="mb-4 font-mono text-xs uppercase tracking-widest text-emerald-400">
      Rails Reliability Consulting
    </p>
    <h1 class="text-3xl font-bold leading-tight text-zinc-100 sm:text-4xl">
      Your Rails background jobs are double-charging customers,
      losing data, or backing up under load.
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-zinc-400">
      I find the root cause and give you a prioritized fix plan — fast, fixed-scope,
      and grounded in the exact reliability work I write about.
    </p>
    <a href="https://cal.com/danialasghar/intro"
       class="mt-8 inline-flex items-center gap-2 rounded-lg bg-emerald-500 px-6 py-3 font-medium text-zinc-950 transition hover:bg-emerald-400">
      Book a 20-min intro call <span aria-hidden="true">&rarr;</span>
    </a>
  </section>

  <!-- Proof strip -->
  <section class="mt-14 border-y border-zinc-800 py-5">
    <p class="text-center text-sm text-zinc-400">
      Ranked <span class="text-zinc-200">#1–6</span> for
      <a href="/blog/solid-queue-vs-sidekiq" class="text-emerald-400 hover:underline">Solid Queue vs Sidekiq</a>
      and Sidekiq reliability &middot; Featured in
      <span class="text-zinc-200">Ruby Weekly</span> &amp; <span class="text-zinc-200">RubyFlow</span>
    </p>
  </section>

  <!-- Productized offers -->
  <section class="mt-16">
    <h2 class="text-center text-xl font-semibold text-zinc-200">How I can help</h2>
    <div class="mt-8 grid gap-5">

      <!-- Offer 1 -->
      <article class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-6 transition hover:border-emerald-500/30">
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="text-lg font-semibold text-zinc-100">Background Job Reliability Audit</h3>
          <span class="shrink-0 font-mono text-sm text-emerald-400">Starting at $X,XXX</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-zinc-400">
          Why your jobs run twice, lose data, or pile up — diagnosed against your real code,
          with a prioritized remediation plan. Fixed scope, delivered in one week.
        </p>
        <ul class="mt-4 space-y-1.5 text-sm text-zinc-500">
          <li>&middot; Idempotency &amp; duplicate-execution review</li>
          <li>&middot; Retry, backoff &amp; dead-set strategy</li>
          <li>&middot; Prioritized, code-level fix plan</li>
        </ul>
      </article>

      <!-- Offer 2 -->
      <article class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-6 transition hover:border-emerald-500/30">
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="text-lg font-semibold text-zinc-100">Sidekiq / Solid Queue Scaling &amp; Tuning</h3>
          <span class="shrink-0 font-mono text-sm text-emerald-400">Starting at $X,XXX</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-zinc-400">
          Throughput, queue latency, connection-pool exhaustion, and retry-storm remediation
          for production queues under real load.
        </p>
        <ul class="mt-4 space-y-1.5 text-sm text-zinc-500">
          <li>&middot; Worker/thread &amp; connection-pool sizing</li>
          <li>&middot; Queue latency vs execution-time diagnosis</li>
          <li>&middot; Backend selection &amp; migration guidance</li>
        </ul>
      </article>

      <!-- Offer 3 -->
      <article class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-6 transition hover:border-emerald-500/30">
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="text-lg font-semibold text-zinc-100">Postgres Concurrency &amp; Lock Review</h3>
          <span class="shrink-0 font-mono text-sm text-emerald-400">Starting at $X,XXX</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-zinc-400">
          Race conditions, locking, and deadlocks — found and fixed before they corrupt data.
        </p>
        <ul class="mt-4 space-y-1.5 text-sm text-zinc-500">
          <li>&middot; Race-condition &amp; locking audit</li>
          <li>&middot; Transaction isolation &amp; deadlock analysis</li>
          <li>&middot; Safe-concurrency patterns for your schema</li>
        </ul>
      </article>
    </div>
  </section>

  <!-- How it works -->
  <section class="mt-16">
    <h2 class="text-center text-xl font-semibold text-zinc-200">How it works</h2>
    <ol class="mt-8 grid gap-6 sm:grid-cols-3">
      <li class="text-center">
        <div class="mx-auto flex h-9 w-9 items-center justify-center rounded-full border border-emerald-500/40 font-mono text-sm text-emerald-400">1</div>
        <p class="mt-3 text-sm text-zinc-400">A short call to scope the problem and confirm fit.</p>
      </li>
      <li class="text-center">
        <div class="mx-auto flex h-9 w-9 items-center justify-center rounded-full border border-emerald-500/40 font-mono text-sm text-emerald-400">2</div>
        <p class="mt-3 text-sm text-zinc-400">A focused audit of your code, config, and production behavior.</p>
      </li>
      <li class="text-center">
        <div class="mx-auto flex h-9 w-9 items-center justify-center rounded-full border border-emerald-500/40 font-mono text-sm text-emerald-400">3</div>
        <p class="mt-3 text-sm text-zinc-400">A prioritized written report and the fixes that matter most.</p>
      </li>
    </ol>
  </section>

  <!-- Who it's for -->
  <section class="mt-16 rounded-xl border border-zinc-800 bg-zinc-900/40 p-6">
    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <h3 class="text-sm font-semibold text-emerald-400">A good fit for</h3>
        <p class="mt-2 text-sm text-zinc-400">Production Rails teams doing real volume, hitting reliability or concurrency issues under load.</p>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-zinc-500">Not a fit for</h3>
        <p class="mt-2 text-sm text-zinc-500">Pre-launch MVPs or teams looking for generic Rails feature development.</p>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="mt-16 text-center">
    <h2 class="text-2xl font-bold text-zinc-100">Have a reliability problem in production?</h2>
    <p class="mx-auto mt-3 max-w-xl text-zinc-400">Tell me what's breaking. If I can help, I'll say how; if I can't, I'll point you to who can.</p>
    <a href="https://cal.com/danialasghar/intro"
       class="mt-6 inline-flex items-center gap-2 rounded-lg bg-emerald-500 px-6 py-3 font-medium text-zinc-950 transition hover:bg-emerald-400">
      Book an intro call <span aria-hidden="true">&rarr;</span>
    </a>
    <p class="mt-4 text-sm text-zinc-500">
      Prefer email? <a href="/contact" class="text-emerald-400 hover:underline">Send an inquiry &rarr;</a>
    </p>
  </section>
</main>

<%# Service JSON-LD for rich results %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Rails Reliability Engineering Consulting",
  "provider": {
    "@type": "Person",
    "name": "Danial Asghar",
    "url": "https://danialasghar.com",
    "jobTitle": "Senior Backend Reliability Engineer",
    "knowsAbout": ["Ruby on Rails", "Sidekiq", "Solid Queue", "PostgreSQL", "Distributed Systems", "Background Jobs"]
  },
  "areaServed": "Worldwide",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Rails Reliability Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Background Job Reliability Audit" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Sidekiq / Solid Queue Scaling & Tuning" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Postgres Concurrency & Lock Review" } }
    ]
  }
}
</script>
