<%# app/views/blog/show.html.erb %>
<%#
  Reference version showing the two integration points. Merge into your existing
  blog show view. The <head> tags belong in your layout; shown here for clarity.
%>

<%# --- in your layout <head> (app/views/layouts/application.html.erb): --- %>
<%#
  <title><%= seo_title %></title>
  <meta name="description" content="<%= seo_description %>">
  <%= seo_og_tags %>
%>

<article class="prose prose-invert mx-auto max-w-2xl px-5 py-12">
  <%= yield %> <%# or your rendered post body, e.g. <%= @post.body_html.html_safe %> %>

  <%#
    End-of-post CTA. Choose the variant that matches the post topic:
      sidekiq  → Sidekiq/queue posts (A1, A3, A4, A6, slow-jobs)
      postgres → Postgres/concurrency posts (Pillar B)
      reliability → everything else (default)
  %>
  <%= render "shared/article_services_cta", variant: :sidekiq %>
</article>
