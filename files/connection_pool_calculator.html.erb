<%# SoftwareApplication schema for the app rich result %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Sidekiq & Puma Connection Pool Calculator",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
}
</script>

<script>
(function () {
  "use strict";
  var ids = ["puma_workers","puma_threads","sidekiq_processes","sidekiq_concurrency","db_pool","db_max"];
  var el = {}; ids.forEach(function (id) { el[id] = document.getElementById(id); });
  var verdict = document.getElementById("verdict");
  var snippet = document.getElementById("snippet");

  function val(id) { var n = parseInt(el[id].value, 10); return (isNaN(n) || n < 1) ? 1 : n; }

  function compute() {
    var pumaW = val("puma_workers"), pumaT = val("puma_threads");
    var skP = val("sidekiq_processes"), skC = val("sidekiq_concurrency");
    var pool = val("db_pool"), dbMax = val("db_max");

    // A pool must cover the threads in its own process. Headroom of 2 is a safe default.
    var minWebPool = pumaT + 2;
    var minWorkerPool = skC + 2;
    var recommendedPool = Math.max(minWebPool, minWorkerPool);

    // Peak connections across ALL processes (worst case: every thread active).
    var totalPeak = (pumaW * pumaT) + (skP * skC);

    var problems = [];
    if (pool < pumaT)  problems.push("Web pool (" + pool + ") is smaller than Puma threads (" + pumaT + ") — web requests will hit ConnectionTimeoutError.");
    if (pool < skC)    problems.push("Worker pool (" + pool + ") is smaller than Sidekiq concurrency (" + skC + ") — jobs will stall waiting for a connection.");
    if (totalPeak > dbMax) problems.push("Peak connections (" + totalPeak + ") can exceed Postgres max_connections (" + dbMax + ") — add PgBouncer or lower concurrency.");

    if (problems.length === 0) {
      verdict.className = "mt-6 rounded-lg border border-emerald-500/40 bg-emerald-500/[0.06] p-4 text-sm text-emerald-200";
      verdict.innerHTML = "&#10003; Safe. Pool covers your threads, and peak connections (" +
        totalPeak + ") stay within Postgres's limit of " + dbMax + ".";
    } else {
      verdict.className = "mt-6 rounded-lg border p-4 text-sm";
      verdict.style.borderColor = "rgba(196,122,99,0.5)";
      verdict.style.background = "rgba(196,122,99,0.08)";
      verdict.style.color = "#e0aa98";
      verdict.innerHTML = "&#10007; Risk:<ul class='mt-2 list-disc pl-5 space-y-1'>" +
        problems.map(function (p) { return "<li>" + p + "</li>"; }).join("") + "</ul>";
    }

    snippet.textContent =
      "production:\n" +
      "  adapter: postgresql\n" +
      "  # set pool >= threads in THIS process (web or worker)\n" +
      "  pool: <%%= ENV.fetch(\"RAILS_MAX_THREADS\") { " + recommendedPool + " } %%>\n" +
      "  # peak across all processes: " + totalPeak + " / " + dbMax + " Postgres connections";
  }

  ids.forEach(function (id) { el[id].addEventListener("input", compute); });

  document.getElementById("copyBtn").addEventListener("click", function () {
    navigator.clipboard.writeText(snippet.textContent).then(function () {
      var b = document.getElementById("copyBtn");
      b.textContent = "Copied"; setTimeout(function () { b.textContent = "Copy"; }, 1500);
    });
  });

  compute();
})();
</script>
