# Cloudflare static-assets headers. Rules combine: every path gets /*, and the
# more specific rules below add caching. See TOOLS_ROADMAP.md §11.4–§11.5.
#
# Security headers for every route (blog, tools, everything).
# - CSP script-src hashes are filled in at build time by integrations/csp-hashes.mjs
#   (the placeholder must stay exactly as written).
# - CSP is enforced. It shipped as Report-Only first; the live site showed no violations.
# - HSTS is at rollout stage 1 (5 minutes, no includeSubDomains/preload).
#   Raise it only per the staged rollout in §11.4 — never jump to preload.
/*
  Strict-Transport-Security: max-age=300
  Content-Security-Policy: default-src 'self'; script-src 'self' '__CSP_SCRIPT_HASHES__'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://assets.mailerlite.com; worker-src 'self'; manifest-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://assets.mailerlite.com; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), serial=(), usb=(), xr-spatial-tracking=(), browsing-topics=()

# Astro fingerprints files in /_astro/ so they are safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
